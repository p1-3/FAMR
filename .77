--[[==========================================================================
  AUTO FARM HUB (WindUI)
  รวม: Auto Farm v2.4 + ระบบฝากเงินที่ ATM (ตามเกณฑ์) + Utilities
  - ฝากเงิน: เมื่อเงินในมือถึงเกณฑ์ -> เดินไปที่ Interior.ATM -> ฝากทั้งหมด -> กลับไปฟาร์มต่อ
  - รับกล่อง: กด ProximityPrompt รัว (burst) จนกล่องเต็ม/ไม่เพิ่มแล้ว
  - แก้บั๊ก: log ถูกเรียกก่อนประกาศ / getupvalue / Door Killer กวาด Workspace ถี่เกิน
  - แก้บั๊ก: ขึ้นหลังคาแล้วลงไม่ได้ (walkNoclipOnce / goTo / walkTo bail-out)
  - แก้: P3/P4 เอาจุดออก เดินผ่านประตู Interior.DoorSystem เข้าไปหาโซนรับกล่องเลย
  - แก้: เช็ค ProximityPrompt.Enabled ของ ATM ก่อนฝาก
  - แก้: Utilities เปิดทุกฟังก์ชันเป็น Default และแสดงสถานะ
  - แก้: UI ฝากเงินโชว์แค่เงินในมือ/ธนาคาร
  - แก้ (ใหม่): ติดที่ขอบหน้าประตู -> แคชประตูแยกเป็นบาน เลือกบานที่อยู่ระหว่างเรากับเป้าหมาย
                แล้ว Tween ทะลุผ่าน 3 จุด (หน้าประตู -> กลางประตู -> หลังประตู) + เปิด brute เป็นแผนสำรอง
==========================================================================]]

local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

