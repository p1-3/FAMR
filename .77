local UI = { status = "พร้อม", step = "-", num = "—" }
local function setStatus(t) UI.status = t end
local function setStep(t) UI.step = t end

local M = {}
local hoverH = 3
local applied = false
local lastStock, lastNum = 0, nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
rayParams.RespectCanCollide = true

local function flatDist(a, b) return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end
local function flatUnit(v)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then return nil end
	return f.Unit
end

local function posOf(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Attachment") then return inst.WorldPosition end
	if inst:IsA("Model") then
		local ok, cf = pcall(function() return inst:GetPivot() end)
		if ok then return cf.Position end
	end
	local p = inst:FindFirstAncestorWhichIsA("BasePart")
	return p and p.Position or nil
end

local function quick11()
	local n = Workspace:FindFirstChild("Map")
	n = n and n:FindFirstChild("Tiles")
	n = n and n:FindFirstChild("GasStationTile")
	return n and n:FindFirstChild("Quick11")
end
local function getInterior()
	local q = quick11()
	return q and q:FindFirstChild("Interior")
end

-- 🚪 ดึงข้อมูลประตู + แคชตำแหน่ง (แยกเป็นบานๆ)
local function getDoorSystem()
	local i = getInterior()
	return i and i:FindFirstChild("DoorSystem")
end

local cachedDoorPos = nil
local cachedDoors = {} -- { {pos, cf, size}, ... }
local function captureDoorPos()
	local ds = getDoorSystem()
	if ds then
		local list, positions = {}, {}
		for _, d in ipairs(ds:GetDescendants()) do
			if d:IsA("BasePart") then
				positions[#positions + 1] = d.Position
				list[#list + 1] = { pos = d.Position, cf = d.CFrame, size = d.Size }
			end
		end
		if #positions > 0 then
			cachedDoors = list
			local sum = Vector3.zero
			for _, p in ipairs(positions) do sum += p end
			cachedDoorPos = sum / #positions
			return cachedDoorPos
		end
		if ds:IsA("Model") then
			local ok, cf = pcall(function() return ds:GetPivot() end)
			if ok and cf then cachedDoorPos = cf.Position return cachedDoorPos end
		end
	end
	return cachedDoorPos
end

------------------------------------------------------------
-- Net counter + เงิน
------------------------------------------------------------
local NetTbl
local function refreshTbl()
	pcall(function()
		local Net = require(RS.Modules.Core.Net)
		local ups = debug.getupvalues(Net.get)
		for _, upv in pairs(ups) do
			if type(upv) == "table" and upv.func ~= nil and upv.event ~= nil then NetTbl = upv return end
		end
		for _, upv in pairs(ups) do
			if type(upv) == "table" and upv.func ~= nil then NetTbl = upv return end
		end
	end)
	if not NetTbl then
		pcall(function()
			for _, v in ipairs(getgc(true)) do
				if typeof(v) == "table" and rawget(v, "event") and rawget(v, "func") then NetTbl = v break end
			end
		end)
	end
	return NetTbl ~= nil
end
refreshTbl()

local function bumpEvent()
	if not NetTbl then refreshTbl() end
	if NetTbl and type(NetTbl.event) == "number" then
		NetTbl.event += 1
		return NetTbl.event
	end
	return nil
end

local function callGet(action, ...)
	if not NetTbl then refreshTbl() end
	if not NetTbl then return false end
	NetTbl.func = (NetTbl.func or 0) + 1
	local a = table.pack(...)
	local ok, res = pcall(function()
		return RemoteGet:InvokeServer(NetTbl.func, action, table.unpack(a, 1, a.n))
	end)
	return ok and res == true
end

local okData, DataModule = pcall(require, RS.Modules.Core.Data)
if not okData then DataModule = nil end

local function getMoney()
	local m = DataModule and DataModule.money
	if type(m) ~= "table" then return 0, 0 end
	return tonumber(m.hand) or 0, tonumber(m.bank) or 0
end

local function fmt(n)
	n = tonumber(n) or 0
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

local function depositAmount(amount)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then return false end
	if callGet("transfer_funds", "hand", "bank", amount) then return true end
	task.wait(0.3)
	return callGet("transfer_funds", "hand", "bank", amount)
end

local Cfg = { AutoOn = false, Mode = "all", Threshold = 500, Cooldown = 5 }
local totalDeposited, depositCount, lastResult = 0, 0, "—"
local lastDepositTry = 0

local modeLabel = {
	excess = "ฝากส่วนเกิน (เก็บเกณฑ์ไว้)",
	all    = "ฝากทั้งหมด (เมื่อถึงเกณฑ์)",
}
local function computeDeposit(hand)
	if Cfg.Mode == "all" then
		return hand >= Cfg.Threshold and hand > 0 and hand or 0
	end
	return hand > Cfg.Threshold and (hand - Cfg.Threshold) or 0
end

------------------------------------------------------------
-- ดักรีโมท
------------------------------------------------------------
local function onRemote(self, ...)
	local a1, a2 = ...
	if typeof(self) == "Instance" and type(a1) == "number" and type(a2) == "string" then
		lastNum = a1
		UI.num = ("%d (%s)"):format(a1, a2)
		if a2 == "player_stocked_shelf" then lastStock = os.clock() end
	end
end
pcall(function()
	local old
	old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local m = getnamecallmethod()
		if m == "InvokeServer" or m == "FireServer" then onRemote(self, ...) end
		return old(self, ...)
	end))
end)
pcall(function()
	local oldI
	oldI = hookfunction(RemoteGet.InvokeServer, newcclosure(function(self, ...)
		onRemote(self, ...)
		return oldI(self, ...)
	end))
end)

------------------------------------------------------------
-- 🚪 ประตู / Door Killer
------------------------------------------------------------
local function getBasementDoor()
	local n = Workspace:FindFirstChild("Map")
	n = n and n:FindFirstChild("Tiles")
	n = n and n:FindFirstChild("GasStationTile")
	n = n and n:FindFirstChild("Cellar")
	return n and n:FindFirstChild("BasementDoor")
end

local function killBasementDoor()
	local bd = getBasementDoor()
	if bd then
		pcall(function() bd:Destroy() end)
		log("ลบ Cellar.BasementDoor")
		return true
	end
	return false
end

local function isDoorName(name) return name:lower():find("door") ~= nil end

local killedModules = {}
local function tryHookDoorModule()
	pcall(function()
		local mg = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Game")
		if not mg then return end
		local mod = mg:FindFirstChild("DoorSystem") or mg:FindFirstChild("Door")
			or mg:FindFirstChild("Doors") or mg:FindFirstChild("DoorModule")
		if not mod or killedModules[mod] then return end
		local m = require(mod)
		if type(m) ~= "table" then return end
		local names = { "lock", "close", "set_locked", "set_open", "disable", "shut" }
		for _, fn in ipairs(names) do
			if type(m[fn]) == "function" then m[fn] = function() end end
		end
		for _, v in pairs(m) do
			if type(v) == "table" then
				for _, fn in ipairs(names) do
					if type(v[fn]) == "function" then v[fn] = function() end end
				end
			end
		end
		killedModules[mod] = true
		log("[DoorSystem] hook module: " .. mod:GetFullName())
	end)
end

local function killInteriorDoorSystem()
	local interior = getInterior()
	local ds = interior and interior:FindFirstChild("DoorSystem")
	if not ds then return false end
	for _, v in ipairs(ds:GetDescendants()) do
		if v:IsA("BasePart") then
			pcall(function()
				v.CanCollide = false
				v.CanTouch = false
				if v.Transparency < 0.9 then v.Transparency = 1 end
			end)
		elseif v:IsA("ProximityPrompt") or v:IsA("ClickDetector") then
			pcall(function() v:Destroy() end)
		end
	end
	return pcall(function() ds:Destroy() end)
end

local function disablePart(v)
	if v:IsA("BasePart") and isDoorName(v.Name) then
		pcall(function()
			v.CanCollide = false
			v.CanTouch = false
			if v.Transparency < 0.7 then v.Transparency = 0.7 end
		end)
		return true
	end
	return false
end

local function sweepShopDoors()
	local n = 0
	if killInteriorDoorSystem() then n += 1 end
	if killBasementDoor() then n += 1 end
	local q = quick11()
	if q then
		for _, v in ipairs(q:GetDescendants()) do
			if disablePart(v) then
				n += 1
			elseif (v:IsA("ProximityPrompt") or v:IsA("Model") or v:IsA("Folder")) and isDoorName(v.Name) then
				pcall(function() v:Destroy() end)
			end
		end
	end
	return n
end

local function destroyDoorModules()
	for _, v in ipairs(RS:GetDescendants()) do
		if (v:IsA("ModuleScript") or v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and isDoorName(v.Name) then
			pcall(function()
				log("[DoorSystem] destroy: " .. v:GetFullName())
				v:Destroy()
			end)
		end
	end
end

local doorThread, doorConn
local function startDoorKiller()
	if doorThread then return end
	tryHookDoorModule()
	destroyDoorModules()
	local n = sweepShopDoors()
	log(("✅ Door Killer เปิด (ปิดการชน %d ชิ้น)"):format(n))
	local q = quick11()
	if q then
		doorConn = q.DescendantAdded:Connect(function(v)
			if S.doorKiller then task.defer(disablePart, v) end
		end)
	end
	doorThread = task.spawn(function()
		while S.doorKiller do
			pcall(tryHookDoorModule)
			pcall(killInteriorDoorSystem)
			pcall(killBasementDoor)
			task.wait(2)
		end
		doorThread = nil
	end)
end
local function stopDoorKiller()
	S.doorKiller = false
	if doorConn then doorConn:Disconnect() doorConn = nil end
end

