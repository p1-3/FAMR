	startAntiRagdoll()
	startInfStamina()
	startAutoHeal()
	startAutoRespawn()
end)

task.spawn(function()
	-- 🚪 แคชตำแหน่งประตู (แยกเป็นบาน) ก่อนที่ Door Killer จะทำลาย DoorSystem
	for _ = 1, 20 do
		if captureDoorPos() then
			log(("📍 แคชประตูแล้ว %d ชิ้น (กลาง %.1f, %.1f, %.1f)")
				:format(#cachedDoors, cachedDoorPos.X, cachedDoorPos.Y, cachedDoorPos.Z))
			break
		end
		task.wait(0.3)
	end
	task.wait(0.5)
	startDoorKiller()
end)
