------------------------------------------------------------
-- Loop อัปเดต UI
------------------------------------------------------------
task.spawn(function()
	local last = {}
	local function push(key, setter, value)
		if last[key] ~= value then last[key] = value setter(value) end
	end
	while true do
		task.wait(0.4)
		local hand, bank = getMoney()
		push("hand", setHand, ("$%s"):format(fmt(hand)))
		push("bank", setBank, ("$%s"):format(fmt(bank)))

		push("fs", setFStatus, UI.status)
		push("fst", setFStep, UI.step)
		push("fn", setFNum, UI.num)
		local ping = getPing()
		push("fp", setFPing, ("%s • counter: %s"):format(ping and (ping .. " ms") or "-", NetTbl and "OK" or "FAIL"))

		-- อัปเดตสถานะยูทิลิตี้ (แสดงสถานะบน UI แทน log)
		local utilStr = ("Anti-Ragdoll: %s | InfStamina: %s | AutoHeal: %s | AutoRespawn: %s | DoorKiller: %s"):format(
			S.antiRagdoll and "🟢" or "🔴",
			S.infStamina and "🟢" or "🔴",
			S.autoHeal and "🟢" or "🔴",
			S.autoRespawn and "🟢" or "🔴",
			S.doorKiller and "🟢" or "🔴"
		)
		push("us", setUtilStatus, utilStr)

		local n = #logLines
		local from = math.max(1, n - 11)
		push("log", setLog, n == 0 and "—" or table.concat(logLines, "\n", from, n))
	end
end)

