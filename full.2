local function runSync(fn)
	S.running = true
	S.runId += 1
	local myId = S.runId
	S.skip = false
	local ok, res = pcall(fn, myId)
	if S.runId == myId then
		S.running = false
		if S.cleanup then
			local c = S.cleanup
			S.cleanup = nil
			pcall(c)
		end
		S.guidePts, S.guideDirs = nil, nil
		hideGuide()
		hideMarker()
	end
	if not ok then
		warn("[Drive] " .. tostring(res))
		return "error"
	end
	return res
end

function Drive.goToATM(vehicle, atm)
	return runSync(function(myId) return runLeg(vehicle, atm, myId) end)
end

function Drive.goToPoint(vehicle, point, label)
	return runSync(function(myId) return runToPoint(vehicle, point, label or "จุดหมาย", myId) end)
end

function Drive.stop()
	S.running = false
	S.runId += 1
	if S.cleanup then
		local c = S.cleanup
		S.cleanup = nil
		pcall(c)
	end
	S.guidePts, S.guideDirs = nil, nil
	hideGuide()
	hideMarker()
end

local hbConn = RunService.Heartbeat:Connect(function()
	if not S.running or not S.vehicle or not S.vehicle.Parent then return end
	updateGuide(S.vehicle:GetPivot().Position)
end)

function Drive.cleanup()
	hbConn:Disconnect()
	Drive.stop()
	if undergroundPinConn then
		undergroundPinConn:Disconnect()
		undergroundPinConn = nil
	end
	if safePlatConn then
		safePlatConn:Disconnect()
		safePlatConn = nil
	end
	if safePlatform then
		safePlatform:Destroy()
		safePlatform = nil
	end
	pinnedVehicle = nil
	pcall(function() guideFolder:Destroy() end)
end

