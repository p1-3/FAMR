local function clickApply()
	local app = playerGui:FindFirstChild("JobApplication")
	local frame = app and app:FindFirstChild("JobApplicationFrame")
	local btn = frame and frame:FindFirstChild("ApplyJob")
	if not (btn and frame.Visible) then return false end
	if getconnections then
		for _, c in ipairs(getconnections(btn.Activated)) do pcall(c.Fire, c) end
		for _, c in ipairs(getconnections(btn.MouseButton1Click)) do pcall(c.Fire, c) end
	elseif firesignal then
		pcall(firesignal, btn.Activated)
		pcall(firesignal, btn.MouseButton1Click)
	else
		return false
	end
	return true
end

local function applyStep()
	setStep("📝 สมัครงาน")
	local t0 = os.clock()
	while alive() and os.clock() - t0 < 15 do
		if clickApply() then
			applied = true
			log("กดปุ่ม ApplyJob แล้ว")
			task.wait(1.5)
			return
		end
		task.wait(0.7)
	end
	if alive() then applied = true log("UI ไม่ขึ้น ถือว่ามีงานแล้ว ไปต่อ") end
end

------------------------------------------------------------
-- กล่อง / ชั้นวาง
------------------------------------------------------------
local function findBoxTool()
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for i = 1, 2 do
		local c = containers[i]
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and (t:FindFirstChild("Extra1") or t.Name:lower():find("box")) then return t end
			end
		end
	end
end

local function equipBox()
	local t = findBoxTool()
	if t and M.hum and t.Parent ~= player.Character then
		pcall(function() M.hum:EquipTool(t) end)
	end
	return t
end

local function boxCount(tool)
	local c = 0
	for i = 1, CONFIG.BoxMax do
		local e = tool:FindFirstChild("Extra" .. i)
		if e then
			local vis = e:IsA("BasePart") and e.Transparency < 1
			for _, v in ipairs(e:GetChildren()) do
				if v:IsA("BasePart") and v.Transparency < 1 then vis = true break end
			end
			if vis then c = i end
		end
	end
	return c
end

local function jobFolder()
	local i = getInterior()
	return i and i:FindFirstChild("ShelfStockingJob")
end

local function nearestNormalBoxPrompt()
	local jf = jobFolder()
	if not jf then return nil end
	local best, bd = nil, math.huge
	local rootPos = M.root.Position
	for _, d in ipairs(jf:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			local par = d.Parent
			if par and (par.Name:find("NormalBox") or (par.Parent and par.Parent.Name:find("NormalBox"))) then
				local p = posOf(par)
				if p then
					local dist = (p - rootPos).Magnitude
					if dist < bd then best, bd = d, dist end
				end
			end
		end
	end
	return best, bd
end

local function getBoxPickupTarget()
	local jf = jobFolder()
	if jf then
		local best, bd = nil, math.huge
		local rootPos = M.root and M.root.Position or Vector3.new()
		for _, d in ipairs(jf:GetDescendants()) do
			if d:IsA("BasePart") and d.Name:find("NormalBox") then
				local dist = (d.Position - rootPos).Magnitude
				if dist < bd then best, bd = d.Position, dist end
			end
		end
		if best then return best end
		local ok, cf = pcall(function() return jf:GetPivot() end)
		if ok then return cf.Position end
	end
	return nil
end

local function pickupBox()
	setStep("📦 รับกล่อง (กดรัว)")
	local t0 = os.clock()
	local lastCount, lastChange = -1, os.clock()
	while alive() and os.clock() - t0 < CONFIG.PickupTimeout do
		M.pulled = false
		local tool = findBoxTool()
		if tool then
			local count = boxCount(tool)
			if count >= CONFIG.BoxMax then break end
			if count ~= lastCount then lastCount, lastChange = count, os.clock() end
			if os.clock() - lastChange > 1.5 then break end
		end

		local prompt, dist = nearestNormalBoxPrompt()
		if prompt then
			if dist and dist > (prompt.MaxActivationDistance or 10) + 2 then
				local p = posOf(prompt.Parent)
				if p then goToFree(p, 3) end
			end
			if fireproximityprompt then
				for _ = 1, CONFIG.SpamBurst do pcall(fireproximityprompt, prompt) end
			end
		end
		task.wait(0.03)
	end
	local t = equipBox()
	if t then log(("ได้กล่อง %s (ใส่ %d/%d)"):format(t.Name, boxCount(t), CONFIG.BoxMax)) end
	return t ~= nil
end

local function shelfSpots()
	local spots = {}
	local jf = jobFolder()
	if not jf then return spots end
	local shelves = jf:FindFirstChild("Shelves")
	if shelves then
		for i, sh in ipairs(shelves:GetChildren()) do
			local att = sh:FindFirstChildWhichIsA("Attachment", true)
			if att then spots[#spots + 1] = { idx = i, pos = att.WorldPosition, name = sh.Name } end
		end
	end
	if #spots == 0 then
		local n = 0
		for _, d in ipairs(jf:GetDescendants()) do
			if d:IsA("Attachment") then
				local par = d.Parent
				if not (par and par.Name:lower():find("box")) then
					n += 1
					spots[#spots + 1] = { idx = 100 + n, pos = d.WorldPosition, name = par and par.Name or "Attachment" }
				end
			end
		end
	end
	if #spots == 0 then
		local n = 0
		for _, d in ipairs(jf:GetDescendants()) do
			local nm = d.Name:lower()
			if (nm:find("beacon") or nm:find("ring")) and (d:IsA("BasePart") or d:IsA("Model")) then
				local p = posOf(d)
				if p then
					n += 1
					spots[#spots + 1] = { idx = 200 + n, pos = p, name = d.Name }
				end
			end
		end
	end
	table.sort(spots, function(a, b)
		local ka = a.idx == CONFIG.FirstShelfIndex and 0 or a.idx
		local kb = b.idx == CONFIG.FirstShelfIndex and 0 or b.idx
		return ka < kb
	end)
	return spots
end

local function dumpShelfInfo()
	local jf = jobFolder()
	if not jf then log("  ไม่พบ ShelfStockingJob") return end
	local shelves = jf:FindFirstChild("Shelves")
	if shelves then
		local kids = shelves:GetChildren()
		log(("  Shelves: %d ชิ้น"):format(#kids))
		for i = 1, math.min(#kids, 6) do
			local k = kids[i]
			local names = {}
			for _, c in ipairs(k:GetChildren()) do
				if #names < 6 then names[#names + 1] = c.Name .. "(" .. c.ClassName .. ")" end
			end
			log(("  [%d] %s(%s): %s"):format(i, k.Name, k.ClassName, table.concat(names, ", ")))
		end
	else
		log("  ไม่พบ Shelves")
	end
	local atts, beacons = 0, {}
	for _, d in ipairs(jf:GetDescendants()) do
		if d:IsA("Attachment") then atts += 1 end
		local nm = d.Name:lower()
		if (nm:find("beacon") or nm:find("ring")) and #beacons < 6 then
			beacons[#beacons + 1] = d:GetFullName()
		end
	end
	log(("  Attachment ทั้งหมดในงาน: %d"):format(atts))
	if #beacons > 0 then log("  Beacon/ring: " .. table.concat(beacons, " | ")) end
end

local function standUntilStock(timeout, spotPos)
	local base, t0 = lastStock, os.clock()
	while alive() and os.clock() - t0 < timeout do
		if lastStock > base then return true end
		if M.pulled then
			M.pulled = false
			log("โดนดึงตัวระหว่างยืนรอ -> รอต่อ (ซิงค์ตำแหน่งแล้ว)")
			if spotPos and flatDist(M.root.Position, spotPos) > 14 then
				return false
			end
		end
		if not findBoxTool() then return false end
		equipBox()
		task.wait(0.2)
	end
	return false
end

------------------------------------------------------------
-- ATM
------------------------------------------------------------
local function getATM()
	local i = getInterior()
	return i and i:FindFirstChild("ATM")
end

local function depositAtATM()
	local atm = getATM()
	if not atm then
		lastResult = "❌ ไม่พบ ATM"
		log(lastResult)
		return false
	end

	local promptOk = false
	for _, d in ipairs(atm:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			promptOk = true
			break
		end
	end
	if not promptOk then
		lastResult = "❌ ATM ไม่พร้อมใช้งาน (Prompt ปิด)"
		log(lastResult)
		return false
	end

	local apos = posOf(atm)
	if not apos then return false end

	setStep("🏧 ไปตู้ ATM")
	local rootPos = M.root.Position
	local feetY = rootPos.Y - hoverH
	local pts = {}
	for k = 0, 7 do
		local a = math.rad(k * 45)
		local x, z = apos.X + math.cos(a) * 4, apos.Z + math.sin(a) * 4
		local gy = groundAt(x, z, rootPos.Y)
		if gy and math.abs(gy - feetY) < 2.5 then
			local p = Vector3.new(x, gy + hoverH, z)
			pts[#pts + 1] = { pos = p, d = flatDist(p, rootPos) }
		end
	end
	table.sort(pts, function(a, b) return a.d < b.d end)

	local reached = false
	for _, p in ipairs(pts) do
		if not alive() then return false end
		if goToFree(p.pos, 3) then reached = true break end
	end
	if not reached then
		reached = alive() and goToFree(apos, 3)
	end
	if not reached then
		lastResult = "❌ ไปถึง ATM ไม่ได้"
		log(lastResult)
		return false
	end

	local hand = getMoney()
	local amount = computeDeposit(hand)
	if amount <= 0 then return true end
	setStep("💰 ฝากเงิน")
	task.wait(0.3)
	if depositAmount(amount) then
		totalDeposited += amount
		depositCount += 1
		lastResult = ("✅ ฝาก $%s สำเร็จ (ATM)"):format(fmt(amount))
		log(lastResult)
		return true
	end
	lastResult = ("❌ ฝาก $%s ล้มเหลว"):format(fmt(amount))
	log(lastResult)
	return false
end

local function maybeDeposit(force)
	if not (FarmDepositCfg.AutoOn or force) then return end
	local amount = computeDeposit((getMoney()))
	if amount <= 0 then
		if force then lastResult = "⚠ ยังไม่ถึงเกณฑ์ / ไม่มีเงินให้ฝาก" end
		return
	end
	if not force and os.clock() - lastDepositTry < FarmDepositCfg.Cooldown then return end
	lastDepositTry = os.clock()
	log(("เงินในมือถึงเกณฑ์ -> ไปฝากที่ ATM ($%s)"):format(fmt(amount)))
	if not depositAtATM() then
		lastDepositTry = os.clock() + 10
	end
end

------------------------------------------------------------
-- ขั้นตอนหลัก
------------------------------------------------------------
local function checkDepositRequests()
	if S.depositNow then
		S.depositNow = false
		maybeDeposit(true)
	else
		maybeDeposit(false)
	end
end

local function mainFlow()
	setStatus("กำลังฟาร์ม")
	if flatDist(M.root.Position, CONFIG.P2) <= 8 then
		log("อยู่ใกล้ P2 แล้ว ข้ามขั้นตอนเข้า Shop")
	else
		if not enterShop() then return "❌ เข้า Shop ไม่สำเร็จ (ดู Log)" end
	end
	if not alive() then return end

	if applied then
		log("สมัครงานแล้ว ข้าม")
	else
		if flatDist(M.root.Position, CONFIG.P2) > 6 then
			setStep("🚶 ไปจุดสมัครงาน (P2)")
			goToFree(CONFIG.P2, 3)
		end
		if not alive() then return end
		applyStep()
	end
	if not alive() then return end

	local failStreak = 0
	local noSpotTicks = 0
	while alive() do
		checkDepositRequests()
		if not alive() then return end

		if not findBoxTool() then
			setStep("🚶 ไปโซนรับกล่อง (ผ่านประตู)")
			local boxTarget = getBoxPickupTarget()
			local success = false
			if boxTarget then
				success = walkViaDoor(boxTarget, 3)
			else
				local interior = getInterior()
				if interior then
					local ok, cf = pcall(function() return interior:GetPivot() end)
					if ok then success = walkViaDoor(cf.Position, 3) end
				end
			end

			if success then
				failStreak = 0
				if pickupBox() then
				else
					log("รับกล่องไม่สำเร็จ ลองใหม่")
					task.wait(1)
				end
			else
				failStreak += 1
				log("ไปโซนรับกล่องไม่ได้ รอแล้วลองใหม่")
				task.wait(2)
				if failStreak >= 2 then
					log("ไปโซนรับกล่องไม่ได้ติดกัน -> เข้า Shop ใหม่ (P1->P2)")
					failStreak = 0
					enterShop()
				end
			end
		else
			equipBox()
			local spots = shelfSpots()
			if #spots == 0 then
				noSpotTicks += 1
				if noSpotTicks == 1 or noSpotTicks % 8 == 0 then
					log("ไม่พบจุดวางกล่อง (ถือกล่องรออยู่) dump โครงสร้าง:")
					dumpShelfInfo()
				end
				task.wait(2)
			else
				noSpotTicks = 0
				for _, sp in ipairs(spots) do
					if not alive() or not findBoxTool() then break end
					equipBox()
					setStep(("🗄 ไปชั้น #%d (%s)"):format(sp.idx, sp.name))
					if goTo(sp.pos, 3, true) then
						setStep(("⏳ ยืนรอวางกล่อง ชั้น #%d"):format(sp.idx))
						local ok = standUntilStock(CONFIG.StockTimeout, sp.pos)
						log(ok and ("✅ วางกล่องแล้ว ชั้น #%d (เลข %s)"):format(sp.idx, tostring(lastNum))
							or ("หมดเวลา/กล่องหมด ที่ชั้น #%d"):format(sp.idx))
					else
						log(("ไปชั้น #%d ไม่ได้ ข้าม"):format(sp.idx))
					end
					task.wait(0.4)
					checkDepositRequests()
				end
			end
		end
		task.wait(0.2)
	end
end

local function depositOnlyFlow()
	setStatus("ฝากเงิน")
	maybeDeposit(true)
	return "ฝากเสร็จแล้ว"
end

