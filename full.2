	local NetTbl = nil
	local function refreshTbl()
		local ok, ups = pcall(debug.getupvalues, Net.get)
		if not ok or type(ups) ~= "table" then return false end
		for _, upv in pairs(ups) do
			if type(upv) == "table" and upv.func ~= nil and upv.event ~= nil then
				NetTbl = upv
				return true
			end
		end
		for _, upv in pairs(ups) do
			if type(upv) == "table" and upv.func ~= nil then
				NetTbl = upv
				return true
			end
		end
		return false
	end
	refreshTbl()

	local function NetSend(action, ...)
		if not NetTbl then refreshTbl() end
		if not NetTbl then warn("[Net] ไม่พบ counter") return false end
		NetTbl.event = (NetTbl.event or 0) + 1
		local seq = NetTbl.event
		local a = table.pack(...)
		local ok, err = pcall(function()
			RemoteSend:FireServer(seq, action, table.unpack(a, 1, a.n))
		end)
		if not ok then warn("[Net] Send ล้มเหลว: " .. tostring(err)) end
		return ok
	end

	local function NetGet(action, ...)
		if not NetTbl then refreshTbl() end
		if not NetTbl then warn("[Net] ไม่พบ counter") return false end
		NetTbl.func = (NetTbl.func or 0) + 1
		local seq = NetTbl.func
		local a = table.pack(...)
		local ok, res = pcall(function()
			return RemoteGet:InvokeServer(seq, action, table.unpack(a, 1, a.n))
		end)
		if not ok then warn("[Net] Get ล้มเหลว: " .. tostring(res)) end
		return ok, res
	end

	local function callGet(action, ...)
		local ok, res = NetGet(action, ...)
		return ok and res == true
	end

