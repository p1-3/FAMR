local function killBasementDoor()
	local bd = getBasementDoor()
	if bd then
		pcall(function() bd:Destroy() end)
		log("ลบ Cellar.BasementDoor")
		return true
	end
	return false
end

local function isDoorName(name) return name:lower():find("door") ~= nil end

local killedModules = {}
local function tryHookDoorModule()
	pcall(function()
		local mg = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Game")
		if not mg then return end
		local mod = mg:FindFirstChild("DoorSystem") or mg:FindFirstChild("Door")
			or mg:FindFirstChild("Doors") or mg:FindFirstChild("DoorModule")
		if not mod or killedModules[mod] then return end
		local m = require(mod)
		if type(m) ~= "table" then return end
		local names = { "lock", "close", "set_locked", "set_open", "disable", "shut" }
		for _, fn in ipairs(names) do
			if type(m[fn]) == "function" then m[fn] = function() end end
		end
		for _, v in pairs(m) do
			if type(v) == "table" then
				for _, fn in ipairs(names) do
					if type(v[fn]) == "function" then v[fn] = function() end end
				end
			end
		end
		killedModules[mod] = true
		log("[DoorSystem] hook module: " .. mod:GetFullName())
	end)
end

local function killInteriorDoorSystem()
	local interior = getInterior()
	local ds = interior and interior:FindFirstChild("DoorSystem")
	if not ds then return false end
	for _, v in ipairs(ds:GetDescendants()) do
		if v:IsA("BasePart") then
			pcall(function()
				v.CanCollide = false
				v.CanTouch = false
				if v.Transparency < 0.9 then v.Transparency = 1 end
			end)
		elseif v:IsA("ProximityPrompt") or v:IsA("ClickDetector") then
			pcall(function() v:Destroy() end)
		end
	end
	return pcall(function() ds:Destroy() end)
end

local function disablePart(v)
	if v:IsA("BasePart") and isDoorName(v.Name) then
		pcall(function()
			v.CanCollide = false
			v.CanTouch = false
			if v.Transparency < 0.7 then v.Transparency = 0.7 end
		end)
		return true
	end
	return false
end

local function sweepShopDoors()
	local n = 0
	if killInteriorDoorSystem() then n += 1 end
	if killBasementDoor() then n += 1 end
	local q = quick11()
	if q then
		for _, v in ipairs(q:GetDescendants()) do
			if disablePart(v) then
				n += 1
			elseif (v:IsA("ProximityPrompt") or v:IsA("Model") or v:IsA("Folder")) and isDoorName(v.Name) then
				pcall(function() v:Destroy() end)
			end
		end
	end
	return n
end

local function destroyDoorModules()
	for _, v in ipairs(RS:GetDescendants()) do
		if (v:IsA("ModuleScript") or v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and isDoorName(v.Name) then
			pcall(function()
				log("[DoorSystem] destroy: " .. v:GetFullName())
				v:Destroy()
			end)
		end
	end
end

local doorThread, doorConn
local function startDoorKiller()
	if doorThread then return end
	tryHookDoorModule()
	destroyDoorModules()
	local n = sweepShopDoors()
	log(("✅ Door Killer เปิด (ปิดการชน %d ชิ้น)"):format(n))
	local q = quick11()
	if q then
		doorConn = q.DescendantAdded:Connect(function(v)
			if S.doorKiller then task.defer(disablePart, v) end
		end)
	end
	doorThread = task.spawn(function()
		while S.doorKiller do
			pcall(tryHookDoorModule)
			pcall(killInteriorDoorSystem)
			pcall(killBasementDoor)
			task.wait(2)
		end
		doorThread = nil
	end)
end
local function stopDoorKiller()
	S.doorKiller = false
	if doorConn then doorConn:Disconnect() doorConn = nil end
end

