local function makeLive(tab, title, initial)
    local obj
    pcall(function() obj = tab:Paragraph({ Title = title, Desc = initial }) end)
    if obj and obj.SetDesc then return function(text) pcall(obj.SetDesc, obj, text) end end
    return function() end
end

