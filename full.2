local function fmt(n)
	n = tonumber(n) or 0
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

local function depositAmount(amount)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then return false end
	if callGet("transfer_funds", "hand", "bank", amount) then return true end
	task.wait(0.3)
	return callGet("transfer_funds", "hand", "bank", amount)
end

