	local function myPos()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		return hrp and hrp.Position or Vector3.zero
	end

	local function atmReadyLive(atm)
		local ready = false
		local part = atm:FindFirstChild("Part")
		local pr = part and part:FindFirstChild("ProximityPrompt")
		if pr and pr:IsA("ProximityPrompt") then ready = pr.Enabled end
		if not ready then
			local fb = atm:FindFirstChildWhichIsA("ProximityPrompt", true)
			if fb then ready = fb.Enabled end
		end
		return ready
	end

	local function isSeated()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.SeatPart ~= nil
	end

	local readyCache = {}
	local function atmState(atm)
		local key = Drive.atmKey(atm)
		if not isSeated() then
			local r = atmReadyLive(atm)
			readyCache[key] = { ready = r, t = os.clock() }
			return r
		end
		local c = readyCache[key]
		if not c then return nil end
		if not c.ready and os.clock() - c.t > 45 then return nil end
		return c.ready
	end

	-- ==========================================================
	-- ✅ I: Bank fallback — ตู้ไหนถอน/ฝากไม่ผ่าน → เปลี่ยนตู้
	-- ==========================================================
	local badBankUntil = {}

	local function sortATMsByDist(fromPos)
		local list = Drive.collectATMs()
		table.sort(list, function(a, b)
			return Drive.flatDist(a:GetPivot().Position, fromPos)
				< Drive.flatDist(b:GetPivot().Position, fromPos)
		end)
		return list
	end

	local function pickATM(fromPos, forHack)
		local best, bd
		local now = os.clock()
		for _, a in ipairs(Drive.collectATMs()) do
			local skip = false
			local bk = badBankUntil[Drive.atmKey(a)]
			if bk and bk > now then skip = true end
			if not skip and forHack then
				local bu = badUntil[Drive.atmKey(a)]
				skip = (bu and bu > now) or atmState(a) == false
			end
			if not skip then
				local d = Drive.flatDist(a:GetPivot().Position, fromPos)
				if not bd or d < bd then best, bd = a, d end
			end
		end
		return best
	end

	local function updateHighlights()
		for _, atm in ipairs(Drive.collectATMs()) do
			local h = atm:FindFirstChild("PromptStatusHighlight")
			if not h then
				h = Instance.new("Highlight")
				h.Name = "PromptStatusHighlight"
				h.Adornee = atm
				h.Parent = atm
			end
			local st = atmState(atm)
			h.FillColor = (st == true and Color3.fromRGB(0, 255, 0))
				or (st == false and Color3.fromRGB(255, 0, 0))
				or Color3.fromRGB(255, 170, 0)
			h.OutlineColor = Color3.fromRGB(255, 255, 255)
			h.FillTransparency = 0.5
		end
	end
	local function clearHighlights()
		for _, atm in ipairs(Drive.collectATMs()) do
			local h = atm:FindFirstChild("PromptStatusHighlight")
			if h then h:Destroy() end
		end
	end

	local function exitSeat()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or not hum.SeatPart then return true end
		say("ลงจากรถ...")
		NetGet("exit_seat")
		for _ = 1, 10 do
			if not hum.SeatPart then return true end
			task.wait(0.1)
		end
		pcall(function()
			hum.Sit = false
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end)
		task.wait(0.3)
		return hum.SeatPart == nil
	end

	local function driveTo(fn)
		unpinChar()
		for _ = 1, 3 do
			if not alive() then return false end
			if not Veh.ensureSeated() then return false end
			local vehicle = Drive.getMyVehicle()
			if vehicle then
				if Cfg.UndergroundMode then
					Drive.warpVehicleY(vehicle, Drive.CONFIG.UndergroundY)
					task.wait(0.25)
				end
				local res = fn(vehicle)
				if res == "arrived" or res == "skipped" then return true end
				if res == "stopped" then return false end
				say("เส้นทางมีปัญหา (" .. tostring(res) .. ") ลองใหม่...")
			end
			task.wait(1)
		end
		return false
	end

	local function visitATM(atm)
		say("ขับไป " .. atm.Name)
		if not driveTo(function(v) return Drive.goToATM(v, atm) end) then return false end

		if Cfg.UndergroundMode then
			local vehicle = Drive.getMyVehicle()
			local atmPos = atm:GetPivot().Position
			local warpY  = Cfg.HackY or 247
			if vehicle then
				local curPivot = vehicle:GetPivot()
				vehicle:PivotTo(
					CFrame.new(atmPos.X, warpY, atmPos.Z) * (curPivot - curPivot.Position)
				)
				Drive.setPinTarget(warpY)
				task.wait(0.25)
			end
		end

		exitSeat()

		if Cfg.UndergroundMode then
			local atmPos = atm:GetPivot().Position
			pinChar(Vector3.new(atmPos.X, Cfg.HackY or 247, atmPos.Z))
			task.wait(0.15)
		end
		return true
	end

	local function hackAt(atm)
		if not alive() then return end
		say("กำลังแฮก " .. atm.Name .. " ด้วย " .. Cfg.Chip)
		local seen = Hack.run(Cfg.Chip, atm)
		badUntil[Drive.atmKey(atm)] = os.clock() + (seen and 5 or 20)
		readyCache[Drive.atmKey(atm)] = { ready = false, t = os.clock() }
		if seen then
			stats.hacks += 1
			say("แฮกเสร็จ (รวม " .. stats.hacks .. " ครั้ง)")
		else
			say("แฮกไม่สำเร็จ — จะลองตู้อื่นที่พร้อม")
		end
	end

	-- ==========================================================
	-- ✅ I: ถอนเงินแบบ fallback (ลองหลายตู้)
	-- ==========================================================
	local function tryWithdrawAnywhere(amount, fromPos, maxTries)
		maxTries = maxTries or 5
		local list = sortATMsByDist(fromPos)
		local tried = 0
		for _, atm in ipairs(list) do
			if not alive() then return false end
			local key = Drive.atmKey(atm)
			local bu = badBankUntil[key]
			if not (bu and bu > os.clock()) then
				tried += 1
				say(("ถอน $%s ที่ %s (ครั้งที่ %d/%d)"):format(fmt(amount), atm.Name, tried, maxTries))
				local visited = false
				if visitATM(atm) then
					visited = true
					task.wait(0.3)
					if Bank.withdraw(amount) then
						say("✅ ถอนเงินสำเร็จ")
						return true
					end
					say("⚠ ตู้นี้ถอนไม่ผ่าน — เปลี่ยนตู้")
					badBankUntil[key] = os.clock() + 30
				else
					say("⚠ ไปตู้นี้ไม่ได้ — เปลี่ยนตู้")
					badBankUntil[key] = os.clock() + 15
				end
				unpinChar()
				if not Veh.ensureSeated() then return false end
				if Cfg.UndergroundMode then Drive.warpToUnderground() end
				if tried >= maxTries then break end
			end
		end
		return false
	end

	-- ==========================================================
	-- ✅ I: ฝากเงินแบบ fallback (คืนตู้ที่ใช้ได้ด้วย)
	-- ==========================================================
	local function tryDepositAnywhere(amount, fromPos, maxTries)
		maxTries = maxTries or 4
		local list = sortATMsByDist(fromPos)
		local tried = 0
		for _, atm in ipairs(list) do
			if not alive() then return false end
			local key = Drive.atmKey(atm)
			local bu = badBankUntil[key]
			if not (bu and bu > os.clock()) then
				tried += 1
				say(("ฝาก $%s ที่ %s (ครั้งที่ %d/%d)"):format(fmt(amount), atm.Name, tried, maxTries))
				if visitATM(atm) then
					task.wait(0.2)
					if Bank.deposit(amount) then
						say("✅ ฝากเงินสำเร็จ")
						return true, atm
					end
					say("⚠ ตู้นี้ฝากไม่ผ่าน — เปลี่ยนตู้")
					badBankUntil[key] = os.clock() + 30
				else
					say("⚠ ไปตู้นี้ไม่ได้ — เปลี่ยนตู้")
					badBankUntil[key] = os.clock() + 15
				end
				unpinChar()
				if not Veh.ensureSeated() then return false end
				if Cfg.UndergroundMode then Drive.warpToUnderground() end
				if tried >= maxTries then break end
			end
		end
		return false
	end

	local function cycle()
		unpinChar()
		if not Veh.ensureSeated() then task.wait(1.5) return end
		if Cfg.UndergroundMode then Drive.warpToUnderground() end

		local chip = Cfg.Chip
		if countItem(chip) <= 0 then
			local qty = math.max(1, math.floor(Cfg.BuyQty))
			local cost = (CHIP_PRICE[chip] or 0) * qty
			local hand, bank = getMoney()
			say(("ไม่มี %s • ซื้อ %d ชิ้น = $%s (มือ $%s / ธนาคาร $%s)"):format(chip, qty, fmt(cost), fmt(hand), fmt(bank)))

			if hand + bank < cost then
				stopAll(("เงินรวมไม่พอซื้อ %s ×%d"):format(chip, qty))
				return
			end

			if hand < cost then
				local need = math.ceil(cost - hand)
				if not tryWithdrawAnywhere(need, myPos(), 5) then
					stopAll("ถอนเงินไม่สำเร็จ (ลอง 5 ตู้แล้ว)")
					return
				end
				task.wait(0.5)
				unpinChar()
				if not Veh.ensureSeated() then return end
				if Cfg.UndergroundMode then Drive.warpToUnderground() end
			end

			say("ขับไปจุดซื้อชิป")
			if not driveTo(function(v) return Drive.goToPoint(v, Cfg.ShopPoint, "จุดซื้อชิป") end) then return end

			if Cfg.UndergroundMode then
				local vehicle = Drive.getMyVehicle()
				local warpY = Cfg.ShopWarpY or 247
				if vehicle then
					local curPivot = vehicle:GetPivot()
					vehicle:PivotTo(
						CFrame.new(Cfg.ShopPoint.X, warpY, Cfg.ShopPoint.Z) * (curPivot - curPivot.Position)
					)
					Drive.setPinTarget(warpY)
					task.wait(0.25)
				end
			end

			exitSeat()

			if Cfg.UndergroundMode then
				pinChar(Vector3.new(Cfg.ShopPoint.X, Cfg.ShopWarpY or 247, Cfg.ShopPoint.Z))
				task.wait(0.15)
			end

			local shop
			waitUntil(function()
				shop = Workspace:FindFirstChild("ShopZone_Illegal")
				return shop ~= nil
			end, 5)
			if not shop then
				unpinChar()
				stopAll("ไม่พบ workspace.ShopZone_Illegal")
				return
			end

			local got = Bank.buy(chip, qty, shop)
			unpinChar()

			if got <= 0 then
				buyFails += 1
				if buyFails >= 2 then
					stopAll("ซื้อชิปไม่ผ่าน 2 ครั้ง")
				end
				return
			end
			buyFails = 0
			say(("ซื้อได้ %d/%d ชิ้น"):format(got, qty))

			local leftover = math.floor((getMoney()) - Cfg.KeepOnHand)
			if Cfg.AutoDeposit and leftover > 0 then
				local ok, usedATM = tryDepositAnywhere(leftover, myPos(), 4)
				if ok then
					task.wait(0.5)
					if usedATM and atmReadyLive(usedATM) then
						hackAt(usedATM)
						return
					end
					unpinChar()
					if not Veh.ensureSeated() then return end
					if Cfg.UndergroundMode then Drive.warpToUnderground() end
				else
					notify("ฝากเงินไม่สำเร็จ", "ลอง 4 ตู้แล้ว — ข้ามไปแฮกต่อ")
					unpinChar()
					if not Veh.ensureSeated() then return end
					if Cfg.UndergroundMode then Drive.warpToUnderground() end
				end
			end
		end

		if not alive() then return end
		local atm = pickATM(myPos(), true)
		if not atm then
			say("ไม่มีตู้ที่พร้อมแฮก (แดงทุกตู้) รอสักครู่...")
			task.wait(2)
			return
		end
		if not visitATM(atm) then return end
		if not waitUntil(function() return atmReadyLive(atm) end, 2.5) then
			local key = Drive.atmKey(atm)
			badUntil[key] = os.clock() + 10
			readyCache[key] = { ready = false, t = os.clock() }
			say(atm.Name .. " ยังไม่พร้อม (แดง) — ไปตู้อื่น")
			unpinChar()
			return
		end
		hackAt(atm)
	end

	local function startLoop()
		if Cfg.Active then return end
		Cfg.Manual = false
		Cfg.Active = true
		buyFails = 0
		task.spawn(function()
			say("เริ่มระบบอัตโนมัติ (ใต้ดิน Y=" .. Cfg.UndergroundY .. " / แฮก Y=" .. Cfg.HackY .. ")")
			while Cfg.Active and not Cfg.Destroyed do
				local ok, err = pcall(cycle)
				if not ok then
					warn("[AutoATM] " .. tostring(err))
					say("ผิดพลาด: " .. tostring(err))
					task.wait(2)
				end
				task.wait(0.3)
			end
			unpinChar()
			Drive.stop()
		end)
	end

	local function runManual(name, fn)
		if Cfg.Active or Cfg.Manual then
			notify("กำลังทำงานอยู่", "กดหยุดก่อนค่อยทดสอบ")
			return
		end
		Cfg.Manual = true
		task.spawn(function()
			local ok, err = pcall(fn)
			if not ok then warn("[AutoATM] " .. tostring(err)) end
			Cfg.Manual = false
			unpinChar()
			Drive.stop()
			say(name .. " จบแล้ว")
		end)
	end

	local function fullDestroy()
		Cfg.Active, Cfg.Manual, Cfg.Destroyed = false, false, true
		_G.AtmHack_Active = false
		unpinChar()
		pcall(clearHighlights)
		pcall(Drive.cleanup)
		if genv.__AutoATM and genv.__AutoATM.Destroy == fullDestroy then genv.__AutoATM = nil end
	end

