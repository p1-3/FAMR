local function groundAt(x, z, refY)
    local r = Workspace:Raycast(Vector3.new(x, refY + 8, z), Vector3.new(0, -40, 0), rayParams1)
    return r and r.Position.Y or nil
end
local function bodyBlockedAt(a, b, params, rise)
    local dir = b - a
    if dir.Magnitude < 0.1 then return false end
    local flat = flatUnit(dir)
    local center = a + Vector3.new(0, 2.8 + (rise or 0), 0)
    local cf = flat and CFrame.lookAt(center, center + flat) or CFrame.new(center)
    local w = 2 * 1.6
    return Workspace:Blockcast(cf, Vector3.new(w, 3.2, w), dir, params) ~= nil
end
local function bodyBlocked(a, b) return bodyBlockedAt(a, b, rayParams1, 0) end

local threadRun = setmetatable({}, { __mode = "k" })
local function isFarmAlive()
    local id = threadRun[coroutine.running()]
    if id and id ~= FarmState.runId then return false end
    return FarmState.running and FarmState.runId == FarmMove.id and FarmMove.root and FarmMove.root.Parent
        and FarmMove.hum and FarmMove.hum.Parent and FarmMove.hum.Health > 0
end

local function noclipBegin()
    if not FarmMove.char then return end
    FarmMove.ncSaved = FarmMove.ncSaved or {}
    for _, d in ipairs(FarmMove.char:GetDescendants()) do
        if d:IsA("BasePart") then FarmMove.ncSaved[d] = d.CanCollide end
    end
    if not FarmMove.ncConn then
        FarmMove.ncConn = RunService.Stepped:Connect(function()
            for part in pairs(FarmMove.ncSaved or {}) do
                if part.Parent then part.CanCollide = false end
            end
        end)
    end
end
local function noclipEnd()
    if not FarmMove.ncConn then return end
    FarmMove.ncConn:Disconnect()
    FarmMove.ncConn = nil
    for part, v in pairs(FarmMove.ncSaved or {}) do
        if part.Parent then part.CanCollide = v end
    end
    FarmMove.ncSaved = nil
end

local function tweenTo(p, heading)
    local w0 = os.clock()
    while FarmMove.unstick and isFarmAlive() and os.clock() - w0 < 8 do task.wait(0.05) end
    local cfv = FarmMove.cfv
    local cur = cfv.Value.Position
    FarmMove.moveDir = heading
    FarmMove.hum.WalkSpeed = FarmConfig.Speed
    local T = math.max((p - cur).Magnitude / FarmConfig.Speed, 0.03)
    if FarmMove.tween then FarmMove.tween:Cancel() end
    FarmMove.tween = TweenService:Create(cfv, TweenInfo.new(T, Enum.EasingStyle.Linear), { Value = CFrame.lookAt(p, p + heading) })
    FarmMove.tween:Play()
    task.wait(math.max(T - 0.05, 0.01))
end

local function walkNoclipOnce(target, keepY)
    local root, cfv = FarmMove.root, FarmMove.cfv
    cfv.Value = root.CFrame
    FarmMove.pulled = false
    local start = cfv.Value.Position
    local gy = groundAt(target.X, target.Z, target.Y)
    local groundY = gy and (gy + hoverH) or nil
    local goal
    if keepY and groundY and math.abs(start.Y - groundY) <= 6 then
        goal = Vector3.new(target.X, start.Y, target.Z)
    elseif groundY then
        goal = Vector3.new(target.X, groundY, target.Z)
    else
        goal = target
    end
    noclipBegin()
    local n = math.max(1, math.ceil((goal - start).Magnitude / FarmConfig.StepLen))
    local heading = flatUnit(goal - start) or Vector3.new(0, 0, -1)
    for k = 1, n do
        if not isFarmAlive() then noclipEnd() return false end
        if FarmMove.pulled then
            FarmMove.pulled = false
            noclipEnd()
            return false
        end
        tweenTo(start:Lerp(goal, k / n), heading)
    end
    if FarmMove.tween and FarmMove.tween.PlaybackState == Enum.PlaybackState.Playing and isFarmAlive() then
        FarmMove.tween.Completed:Wait()
    end
    noclipEnd()
    FarmMove.moveDir = nil
    local p = cfv.Value.Position
    return isFarmAlive() and flatDist(p, goal) <= FarmConfig.ArriveRadius + 1 and math.abs(p.Y - goal.Y) <= 3
end

local function walkNoclip(target, keepY)
    for attempt = 1, 4 do
        if walkNoclipOnce(target, keepY) then return true end
        if not isFarmAlive() then return false end
        task.wait(0.15)
    end
    return false
end

local function goToFree(target, maxFails)
    if FarmState.noclipAll then
        if walkNoclip(target, true) then return true end
        if not isFarmAlive() then return false end
    end
    return false -- fallback to simple if needed, omitted for brevity in combined
end

local function findBoxTool()
    local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
    for i = 1, 2 do
        local c = containers[i]
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and (t:FindFirstChild("Extra1") or t.Name:lower():find("box")) then return t end
            end
        end
    end
end
local function equipBox()
    local t = findBoxTool()
    if t and FarmMove.hum and t.Parent ~= player.Character then
        pcall(function() FarmMove.hum:EquipTool(t) end)
    end
    return t
end
local function boxCount(tool)
    local c = 0
    for i = 1, FarmConfig.BoxMax do
        local e = tool:FindFirstChild("Extra" .. i)
        if e then
            local vis = e:IsA("BasePart") and e.Transparency < 1
            for _, v in ipairs(e:GetChildren()) do
                if v:IsA("BasePart") and v.Transparency < 1 then vis = true break end
            end
            if vis then c = i end
        end
    end
    return c
end
local function jobFolder()
    local i = getInterior()
    return i and i:FindFirstChild("ShelfStockingJob")
end

local function nearestNormalBoxPrompt()
    local jf = jobFolder()
    if not jf then return nil end
    local best, bd = nil, math.huge
    local rootPos = FarmMove.root.Position
    for _, d in ipairs(jf:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local par = d.Parent
            if par and (par.Name:find("NormalBox") or (par.Parent and par.Parent.Name:find("NormalBox"))) then
                local p = posOf(par)
                if p then
                    local dist = (p - rootPos).Magnitude
                    if dist < bd then best, bd = d, dist end
                end
            end
        end
    end
    return best, bd
end

local function shelfSpots()
    local spots = {}
    local jf = jobFolder()
    if not jf then return spots end
    local shelves = jf:FindFirstChild("Shelves")
    if shelves then
        for i, sh in ipairs(shelves:GetChildren()) do
            local att = sh:FindFirstChildWhichIsA("Attachment", true)
            if att then spots[#spots + 1] = { idx = i, pos = att.WorldPosition, name = sh.Name } end
        end
    end
    table.sort(spots, function(a, b)
        local ka = a.idx == FarmConfig.FirstShelfIndex and 0 or a.idx
        local kb = b.idx == FarmConfig.FirstShelfIndex and 0 or b.idx
        return ka < kb
    end)
    return spots
end

local function pickupBox()
    setFarmStep("📦 รับกล่อง (กดรัว)")
    local t0 = os.clock()
    local lastCount, lastChange = -1, os.clock()
    while isFarmAlive() and os.clock() - t0 < FarmConfig.PickupTimeout do
        FarmMove.pulled = false
        local tool = findBoxTool()
        if tool then
            local count = boxCount(tool)
            if count >= FarmConfig.BoxMax then break end
            if count ~= lastCount then lastCount, lastChange = count, os.clock() end
            if os.clock() - lastChange > 1.5 then break end
        end
        local prompt, dist = nearestNormalBoxPrompt()
        if prompt then
            if fireproximityprompt then
                for _ = 1, FarmConfig.SpamBurst do pcall(fireproximityprompt, prompt) end
            end
        end
        task.wait(0.03)
    end
    local t = equipBox()
    return t ~= nil
end

local function depositAmount(amount)
    amount = math.floor(tonumber(amount) or 0)
    if amount <= 0 then return false end
    if callGet("transfer_funds", "hand", "bank", amount) then return true end
    task.wait(0.3)
    return callGet("transfer_funds", "hand", "bank", amount)
end

local function maybeDeposit(force)
    if not (DepCfg.AutoOn or force) then return end
    local amount = computeDeposit((getMoney()))
    if amount <= 0 then
        if force then lastResult = "⚠ ยังไม่ถึงเกณฑ์ / ไม่มีเงินให้ฝาก" end
        return
    end
    if not force and os.clock() - lastDepositTry < DepCfg.Cooldown then return end
    lastDepositTry = os.clock()
    local atm = getInterior() and getInterior():FindFirstChild("ATM")
    if atm and walkNoclip(posOf(atm), true) then
        if depositAmount(amount) then
            lastResult = ("✅ ฝาก $%s สำเร็จ (ATM)"):format(fmt(amount))
        end
    end
end

local function checkDepositRequests()
    if FarmState.depositNow then
        FarmState.depositNow = false
        maybeDeposit(true)
    else
        maybeDeposit(false)
    end
end

local function mainFlow()
    setFarmStatus("กำลังฟาร์ม")
    while isFarmAlive() do
        checkDepositRequests()
        if not findBoxTool() then
            if pickupBox() then
            else task.wait(1) end
        else
            equipBox()
            local spots = shelfSpots()
            if #spots > 0 then
                for _, sp in ipairs(spots) do
                    if not isFarmAlive() or not findBoxTool() then break end
                    setFarmStep(("🗄 ไปชั้น #%d (%s)"):format(sp.idx, sp.name))
                    if goToFree(sp.pos, 3) then
                        setFarmStep(("⏳ ยืนรอวางกล่อง ชั้น #%d"):format(sp.idx))
                        local base = lastStock
                        local t0 = os.clock()
                        while isFarmAlive() and os.clock() - t0 < FarmConfig.StockTimeout do
                            if lastStock > base then break end
                            task.wait(0.2)
                        end
                    end
                end
            else
                task.wait(2)
            end
        end
        task.wait(0.2)
    end
end

local function depositOnlyFlow()
    setFarmStatus("ฝากเงิน")
    maybeDeposit(true)
    return "ฝากเสร็จแล้ว"
end

local function cleanupMover()
    noclipEnd()
    if FarmMove.tween then FarmMove.tween:Cancel() end
    if FarmMove.conn then FarmMove.conn:Disconnect() end
    if FarmMove.watch then FarmMove.watch:Disconnect() FarmMove.watch = nil end
    pcall(function() RunService:UnbindFromRenderStep("AutoFarmMove") end)
    FarmMove.moveDir = nil
    if FarmMove.hum and FarmMove.hum.Parent then
        FarmMove.hum:Move(Vector3.zero, false)
        if FarmMove.prevSpeed then FarmMove.hum.WalkSpeed = FarmMove.prevSpeed end
    end
    if FarmMove.root and FarmMove.root.Parent then
        FarmMove.root.AssemblyLinearVelocity = Vector3.zero
        FarmMove.root.AssemblyAngularVelocity = Vector3.zero
    end
    if FarmMove.cfv then FarmMove.cfv:Destroy() end
    FarmMove.cfv, FarmMove.conn, FarmMove.tween = nil, nil, nil
end

local function stopFarmRun(msg)
    if not FarmState.running and not FarmMove.cfv then return end
    FarmState.running = false
    FarmState.runId += 1
    cleanupMover()
    setFarmStatus(msg or "หยุดแล้ว")
    setFarmStep("-")
end

local function startFarmRun(flow)
    if FarmState.running then return end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) or hum.Health <= 0 then setFarmStatus("❌ ไม่พบตัวละคร") return end

    FarmState.running = true
    FarmState.runId += 1
    FarmMove = { char = char, hum = hum, root = root, id = FarmState.runId, prevSpeed = hum.WalkSpeed }
    
    local cfv = Instance.new("CFrameValue")
    cfv.Value = root.CFrame
    FarmMove.cfv = cfv
    FarmMove.conn = cfv.Changed:Connect(function(v)
        if root.Parent then
            root.CFrame = v
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    
    RunService:BindToRenderStep("AutoFarmMove", Enum.RenderPriority.Input.Value + 1, function()
        if FarmMove.moveDir and hum.Parent then hum:Move(FarmMove.moveDir, false) end
    end)

    local myId = FarmState.runId
    task.spawn(function()
        threadRun[coroutine.running()] = myId
        local ok, res = pcall(flow)
        if FarmState.runId == myId then
            stopFarmRun(ok and (res or "จบการทำงาน") or "❌ เกิดข้อผิดพลาด")
        end
    end)
end

