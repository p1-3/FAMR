Nav.overlap.MaxParts = 12
Nav.inc.FilterType = Enum.RaycastFilterType.Include
Nav.inc.RespectCanCollide = true
Nav.inc.IgnoreWater = true

------------------------------------------------------------
-- คณิตศาสตร์
------------------------------------------------------------
local function hoverNow()
	return math.max(V.hover + CONFIG.HoverTrim, 0.2)
end
local function scanUp()
	return math.max(V.H, 6)
end
local function flatUnit(v)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then return nil end
	return f.Unit
end
local function flatDist(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end
local function rotY(v, ang)
	return CFrame.Angles(0, ang, 0) * v
end
local function signedAngle(a, b)
	return math.atan2(a:Cross(b).Y, a:Dot(b))
end
local function turnToward(cur, want, maxAng)
	local ang = math.clamp(signedAngle(cur, want), -maxAng, maxAng)
	return rotY(cur, ang).Unit
end

