local NetTbl
local function refreshTbl()
    pcall(function()
        local Net = require(RS.Modules.Core.Net)
        local ups = debug.getupvalues(Net.get)
        for _, upv in pairs(ups) do
            if type(upv) == "table" and upv.func ~= nil and upv.event ~= nil then NetTbl = upv return end
        end
        for _, upv in pairs(ups) do
            if type(upv) == "table" and upv.func ~= nil then NetTbl = upv return end
        end
    end)
    if not NetTbl then
        pcall(function()
            for _, v in ipairs(getgc(true)) do
                if typeof(v) == "table" and rawget(v, "event") and rawget(v, "func") then NetTbl = v break end
            end
        end)
    end
    return NetTbl ~= nil
end
refreshTbl()

local function bumpEvent()
    if not NetTbl then refreshTbl() end
    if NetTbl and type(NetTbl.event) == "number" then
        NetTbl.event += 1
        return NetTbl.event
    end
    return nil
end

local function callGet(action, ...)
    if not NetTbl then refreshTbl() end
    if not NetTbl then return false end
    NetTbl.func = (NetTbl.func or 0) + 1
    local a = table.pack(...)
    local ok, res = pcall(function()
        return RemoteGet:InvokeServer(NetTbl.func, action, table.unpack(a, 1, a.n))
    end)
    return ok and res == true
end

local function NetSend(action, ...)
    if not NetTbl then refreshTbl() end
    if not NetTbl then return false end
    NetTbl.event = (NetTbl.event or 0) + 1
    local seq = NetTbl.event
    local a = table.pack(...)
    local ok = pcall(function()
        RemoteSend:FireServer(seq, action, table.unpack(a, 1, a.n))
    end)
    return ok
end

local function NetGet(action, ...)
    if not NetTbl then refreshTbl() end
    if not NetTbl then return false end
    NetTbl.func = (NetTbl.func or 0) + 1
    local seq = NetTbl.func
    local a = table.pack(...)
    local ok, res = pcall(function()
        return RemoteGet:InvokeServer(seq, action, table.unpack(a, 1, a.n))
    end)
    return ok, res
end

local function getMoney()
    local m = DataModule and DataModule.money
    if type(m) ~= "table" then return 0, 0 end
    return tonumber(m.hand) or 0, tonumber(m.bank) or 0
end

local function fmt(n)
    n = tonumber(n) or 0
    local s = tostring(math.floor(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

local function countItem(name)
    local items = DataModule and DataModule.items
    if type(items) ~= "table" then return 0 end
    local want = tostring(name):lower()
    local total = 0
    for _, cat in pairs(items) do
        if type(cat) == "table" then
            for itemName, group in pairs(cat) do
                if tostring(itemName):lower() == want and type(group) == "table" then
                    local c = 0
                    for _, e in ipairs(group) do
                        local q = type(e) == "table" and tonumber(e.amount or e.count or e.quantity or e.stack) or nil
                        c += q or 1
                    end
                    if c == 0 then
                        for _, e in pairs(group) do
                            if type(e) == "table" then c += 1 end
                        end
                    end
                    total += c
                end
            end
        end
    end
    return total
end

