		Value = { Min = 0, Max = 5000, Default = Cfg.KeepOnHand },
		Callback = function(v) Cfg.KeepOnHand = math.floor(v) end,
	})
	TabATM:Toggle({
		Title = "เดินทางใต้ดิน",
		Desc = "ใช้ระดับ Y ใต้ดินระหว่างเดินทาง",
		Value = Cfg.UndergroundMode,
		Callback = function(v)
			Cfg.UndergroundMode = v
			Drive.setUnderground(v, Cfg.UndergroundY)
		end,
	})
	TabATM:Slider({
		Title = "Y เดินทางใต้ดิน (ค่าเริ่มต้น)",
		Step = 0.5,
		Value = { Min = 0, Max = 800, Default = Cfg.UndergroundY },
		Callback = function(v)
			Cfg.UndergroundY = v
			Drive.CONFIG.UndergroundY = v
			if Cfg.UndergroundMode then Drive.setUnderground(true, v) end
		end,
	})
	TabATM:Slider({
		Title = "Y แฮก ATM (ใต้ตู้)",
		Desc = "ล็อกตำแหน่งตัวละครใต้ ATM (ค่าเริ่มต้น 252)",
		Step = 0.5,
		Value = { Min = 0, Max = 800, Default = Cfg.HackY },
		Callback = function(v) Cfg.HackY = v end,
	})
	TabATM:Slider({
		Title = "Y ซื้อของ (ใต้ร้าน)",
		Desc = "ล็อกตำแหน่งตอนซื้อชิป (ค่าเริ่มต้น 252)",
		Step = 0.5,
		Value = { Min = 0, Max = 800, Default = Cfg.ShopWarpY },
		Callback = function(v) Cfg.ShopWarpY = v end,
	})
	TabATM:Slider({
		Title = "Y บนดิน (fallback)",
		Desc = "ใช้เมื่อ raycast หาพื้นไม่เจอ",
		Step = 0.5,
		Value = { Min = 0, Max = 800, Default = Cfg.GroundYFallback },
		Callback = function(v)
			Cfg.GroundYFallback = v
			Drive.CONFIG.GroundYFallback = v
		end,
	})
	TabATM:Divider()
	local DC = Drive.CONFIG
	TabATM:Slider({
		Title = "ความเร็ว (studs/s)",
		Step = 5,
		Value = { Min = DC.MinSpeed, Max = DC.MaxSpeed, Default = DC.Speed },
		Callback = function(v) DC.Speed = v end,
	})
	TabATM:Slider({
		Title = "รอที่จุดหมาย (วินาที)",
		Step = 1,
		Value = { Min = 0, Max = 10, Default = DC.DwellTime },
		Callback = function(v) DC.DwellTime = math.floor(v) end,
	})
	TabATM:Slider({
		Title = "ปรับความสูงรถจากพื้น",
		Step = 0.5,
		Value = { Min = -3, Max = 5, Default = DC.HoverTrim },
		Callback = function(v) DC.HoverTrim = v end,
	})
	TabATM:Button({
		Title = "หยุด ATM / ซื้อชิป",
		Color = Color3.fromHex("#c0392b"),
		Callback = function() stopAll("หยุดระบบ ATM แล้ว") end,
	})

	task.spawn(function()
		local lastS, lastM = "", ""
		local lastRepair = 0
		while not Cfg.Destroyed do
			local s = curStatus
			if progressText ~= "" and (Cfg.Active or Cfg.Manual) then s = s .. "  •  " .. progressText end
			if Cfg.UndergroundMode then s = "🚇 " .. s end
			if s ~= lastS then
				lastS = s
				setStatusUI(s)
				setModeATMStatus(s)
			end
			setFarmStatusUI(UI.status)
			setFarmStepUI(UI.step)
			setModeFarmStatus(UI.status .. " • " .. UI.step)

			local hand, bank = getMoney()
			local hp = ""
			local pct, cur, max, vname = Veh.health()
			if pct then hp = ("   ❤️ %s %d/%d"):format(vname, cur, max) end
			local m = ("💵 มือ $%s   🏦 ธนาคาร $%s   🎫 %s ×%d   ✅ แฮก %d ครั้ง%s"):format(
				fmt(hand), fmt(bank), Cfg.Chip, countItem(Cfg.Chip), stats.hacks, hp)
			if m ~= lastM then lastM = m setMoneyUI(m) end

			if Cfg.HighlightATM then
				pcall(updateHighlights)
			elseif not isSeated() then
				pcall(function()
					for _, a in ipairs(Drive.collectATMs()) do atmState(a) end
				end)
			end

			if Cfg.AutoRepair and pct and pct <= 0 and os.clock() - lastRepair > 3 then
				lastRepair = os.clock()
				task.spawn(function()
					if Veh.repair() then say("ซ่อมรถสำเร็จ") else say("ซ่อมรถไม่ผ่าน") end
				end)
			end
			task.wait(0.5)
		end
	end)

	genv.__AutoATM = { Destroy = fullDestroy }
	say(("พร้อมใช้งาน — ใต้ดิน Y=%.1f • แฮก Y=%.1f • ร้าน Y=%.1f"):format(
		Cfg.UndergroundY, Cfg.HackY, Cfg.ShopWarpY))
	notify("Auto Farm + ATM Hub", "โหลดเสร็จ — เลือกโหมดจากแท็บแรก")
end

AutoATM_All()
