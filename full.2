CONFIG.Hurdle = true
CONFIG.MaxHurdle = 20
CONFIG.AStarNodes = 1200
S.brute = true
S.guide = true
S.unstick = true

local AGENT_PROFILES = {
	{ r = 2,   h = 5 },
	{ r = 1.2, h = 5 },
	{ r = 0.6, h = 4 },
}

local function groundAt(x, z, refY)
	local r = Workspace:Raycast(Vector3.new(x, refY + 8, z), Vector3.new(0, -40, 0), rayParams)
	return r and r.Position.Y or nil
end

local function bodyBlockedAt(a, b, params, rise)
	local dir = b - a
	if dir.Magnitude < 0.1 then return false end
	local flat = flatUnit(dir)
	local center = a + Vector3.new(0, 2.8 + (rise or 0), 0)
	local cf = flat and CFrame.lookAt(center, center + flat) or CFrame.new(center)
	local w = AGENT.AgentRadius * 1.6
	return Workspace:Blockcast(cf, Vector3.new(w, 3.2, w), dir, params) ~= nil
end
local function bodyBlocked(a, b) return bodyBlockedAt(a, b, rayParams, 0) end

local function hurdleRise(a, b)
	if not CONFIG.Hurdle then return nil end
	local rise = 2
	while rise <= CONFIG.MaxHurdle + 1 do
		if not bodyBlockedAt(a, b, rayParams, rise) then return rise + 1.5 end
		rise += 1.5
	end
	return nil
end

local function canSkip(a, b)
	if bodyBlocked(a, b) then return false end
	local n = math.floor((b - a).Magnitude / 4)
	for k = 1, n do
		local p = a:Lerp(b, k / (n + 1))
		local g = groundAt(p.X, p.Z, p.Y)
		if not g or math.abs(g - p.Y) > 1.6 then return false end
	end
	return true
end

local function smooth(raw)
	local out = { raw[1] }
	local i = 1
	while i < #raw do
		local limit = math.min(#raw, i + 12)
		for k = i + 1, limit do
			if raw[k].jump then limit = k break end
		end
		local j = i + 1
		for k = limit, i + 2, -1 do
			if canSkip(raw[i].pos, raw[k].pos) then j = k break end
		end
		out[#out + 1] = raw[j]
		i = j
	end
	return out
end

local function buildSteps(sm)
	local steps = {}
	for i = 2, #sm do
		local a, b = sm[i - 1].pos, sm[i].pos
		local len = (b - a).Magnitude
		if sm[i].hop then
			local rise = sm[i].hop
			local n = math.max(5, math.ceil(len / 3))
			for k = 1, n do
				local t = k / n
				local base = a:Lerp(b, t)
				local arc = rise * math.sin(math.pi * t)
				steps[#steps + 1] = { pos = Vector3.new(base.X, base.Y + hoverH + arc, base.Z), air = true }
			end
		else
			local n = math.max(1, math.ceil(len / CONFIG.StepLen))
			local seg = {}
			for k = 1, n do
				local p = a:Lerp(b, k / n)
				local gy = groundAt(p.X, p.Z, p.Y)
				local y = (gy and math.abs(gy - p.Y) < 3) and gy or p.Y
				seg[k] = Vector3.new(p.X, y + hoverH, p.Z)
			end
			if sm[i].jump then
				if n == 1 then
					table.insert(seg, 1, (a + b) / 2 + Vector3.new(0, hoverH + CONFIG.JumpHeight, 0))
				else
					local mid = math.ceil(n / 2)
					seg[mid] = seg[mid] + Vector3.new(0, CONFIG.JumpHeight, 0)
				end
			end
			for _, p in ipairs(seg) do steps[#steps + 1] = { pos = p, air = false } end
		end
	end
	return steps
end

local function computePathWith(from, to, prof)
	local path = PathfindingService:CreatePath({
		AgentRadius = prof.r, AgentHeight = prof.h,
		AgentCanJump = true, AgentCanClimb = true,
		WaypointSpacing = AGENT.WaypointSpacing,
	})
	local ok = pcall(function() path:ComputeAsync(from, to) end)
	if ok and path.Status == Enum.PathStatus.Success then return path end
end

local function segmentGoal(pos, dir, angle, dist)
	local d = CFrame.Angles(0, math.rad(angle), 0) * dir
	local p = pos + d * dist
	local r = Workspace:Raycast(Vector3.new(p.X, pos.Y + 150, p.Z), Vector3.new(0, -600, 0), rayParams)
	if r then return r.Position + Vector3.new(0, 1, 0) end
end

local function nearVisited(p, visited)
	for _, v in ipairs(visited) do
		if flatDist(p, v) < CONFIG.VisitedRadius then return true end
	end
	return false
end

local threadRun = setmetatable({}, { __mode = "k" })
local function alive()
	local id = threadRun[coroutine.running()]
	if id and id ~= S.runId then return false end
	return S.running and S.runId == M.id and M.root and M.root.Parent
		and M.hum and M.hum.Parent and M.hum.Health > 0
end

