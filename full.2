task.spawn(function()
    local lastF, lastFS, lastAS, lastAM, lastHand, lastBank, lastRepair = "", "", "", "", "", "", 0
    while true do
        task.wait(0.4)
        
        -- Deposit UI
        local hand, bank = getMoney()
        local handStr = ("$%s"):format(fmt(hand))
        local bankStr = ("$%s"):format(fmt(bank))
        if handStr ~= lastHand then lastHand = handStr setHandUI(handStr) end
        if bankStr ~= lastBank then lastBank = bankStr setBankUI(bankStr) end
        
        -- Farm UI
        if FarmUI.status ~= lastFS then lastFS = FarmUI.status setFStatusUI(lastFS) end
        if FarmUI.step ~= lastF then lastF = FarmUI.step setFStepUI(lastF) end
        
        -- ATM UI
        local s = curATMStatus
        if progressText ~= "" and (ATMCfg.Active or ATMCfg.Manual) then s = s .. "  •  " .. progressText end
        if ATMCfg.UndergroundMode then s = "🚇 " .. s end
        if s ~= lastAS then lastAS = s setATMStatusUI(s) end
        
        local ok, pct, cur, max, vname = pcall(Veh.health)
        if not ok then pct = nil end
        local hp = ""
        if pct then hp = ("   ❤️ %s %d/%d"):format(vname, cur, max) end
        local m = ("💵 มือ $%s   🏦 ธนาคาร $%s   🎫 %s ×%d   ✅ แฮก %d ครั้ง%s"):format(
            fmt(hand), fmt(bank), ATMCfg.Chip, countItem(ATMCfg.Chip), stats.hacks, hp)
        if m ~= lastAM then lastAM = m setATMMoneyUI(m) end
        
        -- ATM Highlights & Repair
        if ATMCfg.HighlightATM then
            pcall(updateHighlights)
        elseif not isSeated() then
            pcall(function() for _, a in ipairs(Drive.collectATMs()) do atmState(a) end end)
        end
        if ATMCfg.AutoRepair and pct and pct <= 0 and os.clock() - lastRepair > 3 then
            lastRepair = os.clock()
            task.spawn(function()
                if Veh.repair() then say("ซ่อมรถสำเร็จ") else say("ซ่อมรถไม่ผ่าน") end
            end)
        end
    end
end)

