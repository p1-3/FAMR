local function computeDeposit(hand)
    if DepCfg.Mode == "all" then
        return hand >= DepCfg.Threshold and hand > 0 and hand or 0
    end
    return hand > DepCfg.Threshold and (hand - DepCfg.Threshold) or 0
end

