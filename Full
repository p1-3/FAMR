local AGENT_PROFILES = { { r = 2, h = 5 }, { r = 1.2, h = 5 }, { r = 0.6, h = 4 } }
local function groundAt(x, z, refY) local r = Workspace:Raycast(Vector3.new(x, refY + 8, z), Vector3.new(0, -40, 0), rayParams); return r and r.Position.Y or nil end
local function bodyBlockedAt(a, b, params, rise)
	local dir = b - a; if dir.Magnitude < 0.1 then return false end
	local flat = flatUnit(dir); local center = a + Vector3.new(0, 2.8 + (rise or 0), 0)
	local cf = flat and CFrame.lookAt(center, center + flat) or CFrame.new(center)
	return Workspace:Blockcast(cf, Vector3.new(AGENT.AgentRadius * 1.6, 3.2, AGENT.AgentRadius * 1.6), dir, params) ~= nil
end
local function bodyBlocked(a, b) return bodyBlockedAt(a, b, rayParams, 0) end
local function canSkip(a, b)
	if bodyBlocked(a, b) then return false end
	local n = math.floor((b - a).Magnitude / 4)
	for k = 1, n do local p = a:Lerp(b, k / (n + 1)); local g = groundAt(p.X, p.Z, p.Y); if not g or math.abs(g - p.Y) > 1.6 then return false end end
	return true
end
local function smooth(raw)
	local out = { raw[1] }; local i = 1
	while i < #raw do
		local limit = math.min(#raw, i + 12)
		for k = i + 1, limit do if raw[k].jump then limit = k break end end
		local j = i + 1
		for k = limit, i + 2, -1 do if canSkip(raw[i].pos, raw[k].pos) then j = k break end end
		out[#out + 1] = raw[j]; i = j
	end
	return out
end
local function buildSteps(sm)
	local steps = {}
	for i = 2, #sm do
		local a, b = sm[i - 1].pos, sm[i].pos
		local len = (b - a).Magnitude
		if sm[i].hop then
			local n = math.max(5, math.ceil(len / 3))
			for k = 1, n do local t = k / n; steps[#steps + 1] = { pos = Vector3.new(a:Lerp(b, t).X, a:Lerp(b, t).Y + hoverH + sm[i].hop * math.sin(math.pi * t), a:Lerp(b, t).Z), air = true } end
		else
			local n = math.max(1, math.ceil(len / CONFIG.StepLen)); local seg = {}
			for k = 1, n do local p = a:Lerp(b, k / n); local gy = groundAt(p.X, p.Z, p.Y); seg[k] = Vector3.new(p.X, (gy and math.abs(gy - p.Y) < 3) and gy + hoverH or p.Y + hoverH, p.Z) end
			if sm[i].jump then
				if n == 1 then table.insert(seg, 1, (a + b) / 2 + Vector3.new(0, hoverH + CONFIG.JumpHeight, 0))
				else seg[math.ceil(n / 2)] = seg[math.ceil(n / 2)] + Vector3.new(0, CONFIG.JumpHeight, 0) end
			end
			for _, p in ipairs(seg) do steps[#steps + 1] = { pos = p, air = false } end
		end
	end
	return steps
end

local threadRun = setmetatable({}, { __mode = "k" })
local function alive()
	local id = threadRun[coroutine.running()]
	if id and id ~= S.runId then return false end
	return S.running and S.runId == M.id and M.root and M.root.Parent and M.hum and M.hum.Parent and M.hum.Health > 0
end

local ncSaved, ncConn
local function noclipBegin()
	if ncConn or not M.char then return end
	ncSaved = {}
	for _, d in ipairs(M.char:GetDescendants()) do if d:IsA("BasePart") then ncSaved[d] = d.CanCollide end end
	ncConn = RunService.Stepped:Connect(function() for part in pairs(ncSaved) do if part.Parent then part.CanCollide = false end end end)
end
local function noclipEnd()
	if not ncConn then return end
	ncConn:Disconnect() ncConn = nil
	for part, v in pairs(ncSaved or {}) do if part.Parent then part.CanCollide = v end end
	ncSaved = nil
end

local function tweenTo(p, heading)
	local w0 = os.clock(); while M.unstick and alive() and os.clock() - w0 < 8 do task.wait(0.05) end
	local cfv = M.cfv; local cur = cfv.Value.Position
	M.moveDir = heading; M.hum.WalkSpeed = CONFIG.Speed
	local T = math.max((p - cur).Magnitude / CONFIG.Speed, 0.03)
	if M.tween then M.tween:Cancel() end
	M.tween = TweenService:Create(cfv, TweenInfo.new(T, Enum.EasingStyle.Linear), { Value = CFrame.lookAt(p, p + heading) })
	M.tween:Play(); task.wait(math.max(T - LEAD, 0.01))
end

local function walkNoclipOnce(target, keepY)
	local root, cfv = M.root, M.cfv
	cfv.Value = root.CFrame; M.pulled = false
	local start = cfv.Value.Position
	local gy = groundAt(target.X, target.Z, target.Y)
	local goal = (keepY and gy and math.abs(start.Y - (gy + hoverH)) <= 6) and Vector3.new(target.X, start.Y, target.Z) or (gy and Vector3.new(target.X, gy + hoverH, target.Z) or target)

	noclipBegin()
	local n = math.max(1, math.ceil((goal - start).Magnitude / CONFIG.StepLen))
	local heading = flatUnit(goal - start) or Vector3.new(0, 0, -1)
	for k = 1, n do
		if not alive() or M.pulled then noclipEnd(); return false end
		tweenTo(start:Lerp(goal, k / n), heading)
	end
	if M.tween and M.tween.PlaybackState == Enum.PlaybackState.Playing and alive() then M.tween.Completed:Wait() end
	noclipEnd(); M.moveDir = nil
	local p = cfv.Value.Position
	return alive() and flatDist(p, goal) <= CONFIG.ArriveRadius + 1 and math.abs(p.Y - goal.Y) <= 3
end

local function walkNoclip(target, keepY)
	for attempt = 1, 4 do
		if walkNoclipOnce(target, keepY) then return true end
		if not alive() then return false end
		task.wait(0.15)
	end
	return false
end

local function goToFree(target, maxFails)
    if S.noclipAll and walkNoclip(target, true) then return true end
    if not alive() then return false end
    local root, cfv = M.root, M.cfv; cfv.Value = root.CFrame
    local start = cfv.Value.Position
    local gy = groundAt(target.X, target.Z, target.Y)
    local goal = gy and Vector3.new(target.X, gy + hoverH, target.Z) or target
    local n = math.max(1, math.ceil((goal - start).Magnitude / CONFIG.StepLen))
    local heading = flatUnit(goal - start) or Vector3.new(0, 0, -1)
    for k = 1, n do
        if not alive() or M.pulled then return false end
        tweenTo(start:Lerp(goal, k / n), heading)
    end
    if M.tween and M.tween.PlaybackState == Enum.PlaybackState.Playing and alive() then M.tween.Completed:Wait() end
    M.moveDir = nil
    return alive() and flatDist(cfv.Value.Position, goal) <= CONFIG.ArriveRadius + 1
end

