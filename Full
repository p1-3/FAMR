local function getATM() local i = getInterior(); return i and i:FindFirstChild("ATM") end

local function goToATM()
	local atm = getATM()
	if not atm then return false end
	local apos = posOf(atm)
	if not apos then return false end

	setStep("🏧 ไปตู้ ATM (ดำดิน)")
    
    -- ใช้พิกัด Y ที่ตั้งไว้ในโหมด ATM (Y_Underground -> Y_ATM)
    local undergroundPos = Vector3.new(apos.X, CONFIG.Y_Underground, apos.Z)
    local finalPos = Vector3.new(apos.X, CONFIG.Y_ATM, apos.Z)

    if walkNoclip(undergroundPos, true) then
        setStep("แฮก ATM")
        walkNoclip(finalPos, true)
        task.wait(1)
    else
        return false
    end

	local hand = getMoney()
	local amount = computeDeposit(hand)
	if amount > 0 then callGet("transfer_funds", "hand", "bank", amount) end
	return true
end

-- ==========================================================================
-- 🏃‍♂️ RUNNER & CLEANUP
-- ==========================================================================
local function cleanupMover()
	noclipEnd()
	if M.tween then M.tween:Cancel() end
	if M.conn then M.conn:Disconnect() end
	if M.watch then M.watch:Disconnect() M.watch = nil end
	pcall(function() RunService:UnbindFromRenderStep("AutoFarmMove") end)
	M.moveDir = nil
	if M.hum and M.hum.Parent then M.hum:Move(Vector3.zero, false); if M.prevSpeed then M.hum.WalkSpeed = M.prevSpeed end end
	if M.cfv then M.cfv:Destroy() end
	M.cfv, M.conn, M.tween = nil, nil, nil
end

local function stopRun(msg)
	if not S.running and not M.cfv then return end
	S.running = false; S.runId += 1; cleanupMover()
	setStatus(msg or "หยุดแล้ว"); setStep("-")
end

local function startRun(flow)
	if S.running then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then setStatus("❌ ไม่พบตัวละคร") return end

	S.running = true; S.runId += 1
	M = { char = char, hum = hum, root = root, id = S.runId, prevSpeed = hum.WalkSpeed }
	hum.Died:Connect(function() applied = false end)

	local pos0 = root.Position
	local g0 = Workspace:Raycast(pos0 + Vector3.new(0, 3, 0), Vector3.new(0, -300, 0), rayParams)
	hoverH = (g0 and math.clamp(pos0.Y - g0.Position.Y, 1.5, 6) or 3) + CONFIG.HeightOffset

	local cfv = Instance.new("CFrameValue")
	cfv.Value = root.CFrame; M.cfv = cfv
	M.conn = cfv.Changed:Connect(function(v)
		if root.Parent then root.CFrame = v; root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
	end)
	
	M.watch = RunService.Heartbeat:Connect(function()
		if not alive() or not M.cfv or os.clock() < (M.ignoreUntil or 0) then return end
		if (root.Position - M.cfv.Value.Position).Magnitude > CONFIG.PullThreshold then
			M.pulled = true; if M.tween then M.tween:Cancel() end; M.moveDir = nil; M.cfv.Value = root.CFrame
		end
	end)
	RunService:BindToRenderStep("AutoFarmMove", Enum.RenderPriority.Input.Value + 1, function()
		if M.moveDir and hum.Parent then hum:Move(M.moveDir, false) end
	end)

	local myId = S.runId
	task.spawn(function()
		threadRun[coroutine.running()] = myId
		local ok, res = pcall(flow)
		if S.runId == myId then stopRun(ok and (res or "จบการทำงาน") or "❌ เกิดข้อผิดพลาด") end
	end)
end

player.CharacterAdded:Connect(function(char)
	applied = false
	if S.running then stopRun("เกิดใหม่") end
	if S.auto then task.wait(CONFIG.ResumeDelay); if S.auto and not S.running then startRun(mainFarmFlow) end end
end)

