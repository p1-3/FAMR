local function findBoxTool()
	for _, c in ipairs({ player.Character, player:FindFirstChildOfClass("Backpack") }) do
		if c then for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") and (t:FindFirstChild("Extra1") or t.Name:lower():find("box")) then return t end end end
	end
end

local function equipBox() local t = findBoxTool(); if t and M.hum and t.Parent ~= player.Character then pcall(function() M.hum:EquipTool(t) end) end return t end
local function jobFolder() local i = getInterior(); return i and i:FindFirstChild("ShelfStockingJob") end

local function getBoxPickupTarget()
	local jf = jobFolder()
	if jf then
		local best, bd = nil, math.huge
		for _, d in ipairs(jf:GetDescendants()) do
			if d:IsA("BasePart") and d.Name:find("NormalBox") then local dist = (d.Position - M.root.Position).Magnitude; if dist < bd then best, bd = d.Position, dist end end
		end
		if best then return best end
	end
	return nil
end

local function pickupBox()
	setStep("📦 รับกล่อง (กดรัว)")
	local t0 = os.clock()
	while alive() and os.clock() - t0 < CONFIG.PickupTimeout do
		M.pulled = false; local prompt = nil; local jf = jobFolder()
		if jf then
			local bd = math.huge
			for _, d in ipairs(jf:GetDescendants()) do
				if d:IsA("ProximityPrompt") and d.Enabled and d.Parent and d.Parent.Name:find("NormalBox") then
					local dist = (posOf(d.Parent) - M.root.Position).Magnitude
					if dist < bd then prompt, bd = d, dist end
				end
			end
		end
		if prompt and fireproximityprompt then for _ = 1, CONFIG.SpamBurst do pcall(fireproximityprompt, prompt) end end
		local tool = findBoxTool(); if tool and #tool:GetChildren() >= CONFIG.BoxMax then break end
		task.wait(0.03)
	end
	return equipBox() ~= nil
end

local function shelfSpots()
	local spots = {}; local jf = jobFolder()
	if jf then local shelves = jf:FindFirstChild("Shelves"); if shelves then for i, sh in ipairs(shelves:GetChildren()) do local att = sh:FindFirstChildWhichIsA("Attachment", true); if att then spots[#spots + 1] = { idx = i, pos = att.WorldPosition } end end end end
	return spots
end

local function standUntilStock(timeout, spotPos)
	local base, t0 = lastStock, os.clock()
	while alive() and os.clock() - t0 < timeout do
		if lastStock > base then return true end
		if M.pulled then return false end
		equipBox(); task.wait(0.2)
	end
	return false
end

local function mainFarmFlow()
	setStatus("กำลังฟาร์มจัดชั้น")
	if flatDist(M.root.Position, CONFIG.P2) > 8 then
		if not enterShop() then return "❌ เข้า Shop ไม่สำเร็จ" end
	end
	if not alive() then return end

	local failStreak = 0
	while alive() do
		if S.depositNow then S.depositNow = false end
		if not findBoxTool() then
			setStep("🚶 ไปโซนรับกล่อง")
			local boxTarget = getBoxPickupTarget()
			if boxTarget and walkNoclip(boxTarget, true) then
				failStreak = 0; pickupBox(); task.wait(CONFIG.WaitAtDest)
			else
				failStreak += 1; task.wait(2)
				if failStreak >= 2 then failStreak = 0; enterShop() end
			end
		else
			equipBox(); local spots = shelfSpots()
			for _, sp in ipairs(spots) do
				if not alive() or not findBoxTool() then break end
				setStep(("🗄 ไปชั้น #%d"):format(sp.idx))
				if goToFree(sp.pos, 3) then
					setStep(("⏳ ยืนรอวางกล่อง ชั้น #%d"):format(sp.idx))
					standUntilStock(CONFIG.StockTimeout, sp.pos)
					task.wait(CONFIG.WaitAtDest)
				end
			end
		end
		task.wait(0.2)
	end
end

