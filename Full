local function findBoxTool()
    local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
    for i = 1, 2 do
        local c = containers[i]
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and (t:FindFirstChild("Extra1") or t.Name:lower():find("box")) then return t end
            end
        end
    end
end

local function equipBox()
    local t = findBoxTool()
    if t and M.hum and t.Parent ~= player.Character then pcall(function() M.hum:EquipTool(t) end) end
    return t
end

local function boxCount(tool)
    local c = 0
    for i = 1, CONFIG.BoxMax do
        local e = tool:FindFirstChild("Extra" .. i)
        if e then
            local vis = e:IsA("BasePart") and e.Transparency < 1
            for _, v in ipairs(e:GetChildren()) do if v:IsA("BasePart") and v.Transparency < 1 then vis = true break end end
            if vis then c = i end
        end
    end
    return c
end

local function jobFolder()
    local i = getInterior()
    return i and i:FindFirstChild("ShelfStockingJob")
end

local function nearestNormalBoxPrompt()
    local jf = jobFolder()
    if not jf then return nil end
    local best, bd = nil, math.huge
    for _, d in ipairs(jf:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local par = d.Parent
            if par and (par.Name:find("NormalBox") or (par.Parent and par.Parent.Name:find("NormalBox"))) then
                local p = posOf(par)
                if p then
                    local dist = (p - M.root.Position).Magnitude
                    if dist < bd then best, bd = d, dist end
                end
            end
        end
    end
    return best, bd
end

local function getBoxPickupTarget()
    local jf = jobFolder()
    if jf then
        local best, bd = nil, math.huge
        for _, d in ipairs(jf:GetDescendants()) do
            if d:IsA("BasePart") and d.Name:find("NormalBox") then
                local dist = (d.Position - M.root.Position).Magnitude
                if dist < bd then best, bd = d.Position, dist end
            end
        end
        if best then return best end
        local ok, cf = pcall(function() return jf:GetPivot() end)
        if ok then return cf.Position end
    end
end

local function pickupBox()
    setStep("📦 รับกล่อง")
    local t0 = os.clock()
    local lastCount, lastChange = -1, os.clock()
    while alive() and os.clock() - t0 < CONFIG.PickupTimeout do
        M.pulled = false
        local tool = findBoxTool()
        if tool then
            local count = boxCount(tool)
            if count >= CONFIG.BoxMax then break end
            if count ~= lastCount then lastCount, lastChange = count, os.clock() end
            if os.clock() - lastChange > 1.5 then break end
        end
        local prompt, dist = nearestNormalBoxPrompt()
        if prompt then
            if dist and dist > (prompt.MaxActivationDistance or 10) + 2 then
                local p = posOf(prompt.Parent)
                if p then walkTo(p, 3) end
            end
            if fireproximityprompt then
                for _ = 1, CONFIG.SpamBurst do pcall(fireproximityprompt, prompt) end
            end
        end
        task.wait(0.03)
    end
    equipBox()
    return findBoxTool() ~= nil
end

local function shelfSpots()
    local spots = {}
    local jf = jobFolder()
    if not jf then return spots end
    local shelves = jf:FindFirstChild("Shelves")
    if shelves then
        for i, sh in ipairs(shelves:GetChildren()) do
            local att = sh:FindFirstChildWhichIsA("Attachment", true)
            if att then spots[#spots + 1] = { idx = i, pos = att.WorldPosition, name = sh.Name } end
        end
    end
    table.sort(spots, function(a, b)
        local ka = a.idx == CONFIG.FirstShelfIndex and 0 or a.idx
        local kb = b.idx == CONFIG.FirstShelfIndex and 0 or b.idx
        return ka < kb
    end)
    return spots
end

local function mainFlow()
    setStatus("กำลังฟาร์ม")
    if flatDist(M.root.Position, CONFIG.P2) > 8 then
        if not enterShop() then return "❌ เข้า Shop ไม่สำเร็จ" end
    end
    if not alive() then return end
    if not applied then
        if flatDist(M.root.Position, CONFIG.P2) > 6 then walkTo(CONFIG.P2, 3) end
        if not alive() then return end
        applyStep()
    end
    if not alive() then return end
    
    local failStreak = 0
    while alive() do
        if not findBoxTool() then
            local boxTarget = getBoxPickupTarget()
            if boxTarget and walkViaDoor(boxTarget, 3) then
                pickupBox()
            else
                failStreak += 1
                task.wait(2)
                if failStreak >= 2 then enterShop() failStreak = 0 end
            end
        else
            equipBox()
            local spots = shelfSpots()
            for _, sp in ipairs(spots) do
                if not alive() or not findBoxTool() then break end
                equipBox()
                if walkTo(sp.pos, 3) then
                    task.wait(CONFIG.StockTimeout) -- รอวางของ
                end
                task.wait(0.4)
            end
        end
        task.wait(0.2)
    end
end

