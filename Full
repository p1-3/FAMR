local NetTbl
local function refreshTbl()
	pcall(function()
		local Net = require(RS.Modules.Core.Net)
		local ups = debug.getupvalues(Net.get)
		for _, upv in pairs(ups) do
			if type(upv) == "table" and upv.func ~= nil and upv.event ~= nil then NetTbl = upv return end
		end
	end)
	if not NetTbl then
		pcall(function()
			for _, v in ipairs(getgc(true)) do
				if typeof(v) == "table" and rawget(v, "event") and rawget(v, "func") then NetTbl = v break end
			end
		end)
	end
	return NetTbl ~= nil
end
refreshTbl()

local function bumpEvent()
	if not NetTbl then refreshTbl() end
	if NetTbl and type(NetTbl.event) == "number" then
		NetTbl.event += 1
		return NetTbl.event
	end
	return nil
end

local function callGet(action, ...)
	if not NetTbl then refreshTbl() end
	if not NetTbl then return false end
	NetTbl.func = (NetTbl.func or 0) + 1
	local a = table.pack(...)
	local ok, res = pcall(function()
		return RemoteGet:InvokeServer(NetTbl.func, action, table.unpack(a, 1, a.n))
	end)
	return ok and res == true
end

