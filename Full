-- Door Killer
local function getBasementDoor()
    local n = Workspace:FindFirstChild("Map")
    n = n and n:FindFirstChild("Tiles")
    n = n and n:FindFirstChild("GasStationTile")
    n = n and n:FindFirstChild("Cellar")
