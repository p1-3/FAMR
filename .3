local function enterShop()
	setStep("🚶 ไปหน้าร้าน (P1)")
	if not goTo(CONFIG.P1, 3) then return false end
	if not alive() then return false end

	M.moveDir = nil
	if M.tween then M.tween:Cancel() M.tween = nil end
	if M.hum and M.hum.Parent then M.hum:Move(Vector3.zero, false) end
	task.wait(0.1)
	if not alive() then return false end

	setStep("📍 Tween ไปจุด P2 (ไม่สนกำแพง)")
	local dest = CONFIG.P2
	if not walkNoclip(dest) then
		if not alive() then return false end
		if not goTo(dest, 4) then return false end
	end
	if not alive() then return false end
	return true
end

