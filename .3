local guideAcc, guideShown = 0, false
local function hideGuide()
	if not guideShown then return end
	guideShown = false
	for i = 1, GN do
		segParts[i].Transparency = 1
		bulbParts[i].Transparency = 1
	end
	star.Transparency = 1
	snow.Enabled = false
	starLight.Enabled = false
end

RunService.Heartbeat:Connect(function(dt)
	guideAcc += dt
	if guideAcc < 0.033 then return end
	guideAcc = 0

	local pts, root = G.pts, M.root
	if not (S.guide and S.running and pts and #pts > 0 and root and root.Parent) then
		hideGuide()
		return
	end
	guideShown = true
	local t = os.clock()
	local off = Vector3.new(0, -hoverH + 0.4, 0)

	local line = { root.Position + off }
	for k = math.max(G.idx, 1), #pts do
		line[#line + 1] = pts[k] + off
		if #line > 120 then break end
	end

	local SP = 3.4
	local samples = { line[1] }
	local need = SP
	for i = 1, #line - 1 do
		local a, b = line[i], line[i + 1]
		local len = (b - a).Magnitude
		local pos = 0
		while len > 0.01 and len - pos >= need and #samples < GN + 1 do
			pos += need
			samples[#samples + 1] = a:Lerp(b, pos / len)
			need = SP
		end
		need -= (len - pos)
		if #samples >= GN + 1 then break end
	end

	local ph = math.floor(t * 5)
	local bp = math.floor(t * 3)
	for i = 1, GN do
		local a, b = samples[i], samples[i + 1]
		local sg, bl = segParts[i], bulbParts[i]
		if a and b and (b - a).Magnitude > 0.01 then
			local fade = math.clamp(0.05 + (i / GN) * 0.85, 0, 0.95)
			sg.Size = Vector3.new(0.32, 0.32, (b - a).Magnitude + 0.05)
			sg.CFrame = CFrame.lookAt((a + b) / 2, b)
			sg.Color = ((i + ph) % 2 == 0) and XRED or XGREEN
			sg.Transparency = fade
			bl.Color = bulbPalette[((i + bp) % 4) + 1]
			local pulse = 0.85 + 0.3 * math.sin(t * 6 + i)
			bl.Size = Vector3.new(pulse, pulse, pulse)
			bl.CFrame = CFrame.new(a + Vector3.new(0, 0.9, 0))
			bl.Transparency = math.clamp(fade + 0.1, 0, 0.95)
		else
			sg.Transparency = 1
			bl.Transparency = 1
		end
	end

	local tgt = G.target
	if tgt then
		star.Transparency = 0.05
		snow.Enabled = true
		starLight.Enabled = true
		star.CFrame = CFrame.new(tgt + Vector3.new(0, 4 + math.sin(t * 3) * 0.5, 0)) * CFrame.Angles(0, t * 2, 0)
	else
		star.Transparency = 1
		snow.Enabled = false
		starLight.Enabled = false
	end
end)

