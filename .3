local healThread
local function findHealTool()
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for i = 1, 2 do
		local c = containers[i]
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and t:GetAttribute("HealthRestoreAmount") then return t end
			end
		end
	end
end
local function useHealTool(tool)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum) then return end
	local cur = char:FindFirstChildOfClass("Tool")
	tool.Parent = char
	task.wait()
	pcall(function() tool:Activate() end)
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, a in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() a:Stop(0) end) end
	end
	task.wait(0.25)
	local bp = player:FindFirstChildOfClass("Backpack")
	if cur and bp and cur.Parent == char then pcall(function() cur.Parent = bp end) end
end
local function startAutoHeal()
	if healThread then return end
	healThread = task.spawn(function()
		while S.autoHeal do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and hum.Health < CONFIG.HealThreshold then
				local tool = findHealTool()
				if tool then pcall(useHealTool, tool) end
			end
			task.wait(CONFIG.HealCheckInterval)
		end
		healThread = nil
	end)
end

local respThread
local function startAutoRespawn()
	if respThread then return end
	if not NetTbl and not refreshTbl() then return end
	respThread = task.spawn(function()
		while S.autoRespawn do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
